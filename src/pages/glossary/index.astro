---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
const title = '术语库 · 58词分类速查 | 纯批导读';

interface Term { k: string; b: string; d: string; x?: string }
const groups: { name: string; terms: Term[] }[] = [
  {
    name: '总纲 · 批判哲学的基本设定',
    terms: [
      { k: '批判', b: '批判', d: '审查理性自身的能力与界限，为理性立法，不是简单的否定或批评。批判=划界。', x: '序言' },
      { k: '形而上学', b: '形而上学', d: '研究经验之外、无条件者的学问，传统上包括本体论、宇宙论、理性心理学与自然神学；康德要重建立其科学身份。', x: '序言/导言' },
      { k: '先天', b: '先天', d: '不依赖任何经验、在经验之先的知识；标志是必然性与严格普遍性。', x: '导言' },
      { k: '经验', b: '经验/后天', d: '来自感官知觉的知识，总是偶然的、个别的，是后天知识。', x: '导言' },
      { k: '先验', b: '先验', d: '不是关于对象的，而是关于我们认识对象的方式的知识；只管经验的可能性条件。', x: '导言' },
      { k: '超验', b: '超验', d: '超出一切可能经验界限的使用，是范畴的非法使用，产生幻相。', x: '辩证论' },
      { k: '分析判断', b: '分析判断', d: '谓词已包含在主词概念中，不扩展知识，只澄清概念（单身汉=未婚）。', x: '导言' },
      { k: '综合判断', b: '综合判断', d: '谓词超出主词概念之外，扩展知识（7+5=12）；又分后天综合与先天综合。', x: '导言' },
      { k: '先天综合判断', b: '先天综合判断', d: '既扩展知识又有必然普遍性——全书总问题"如何可能"的对象；数学、自然科学奠基于此。', x: '导言' },
      { k: '哥白尼革命', b: '哥白尼革命', d: '知识必须符合对象→对象必须符合我们认识对象的方式；像哥白尼把运动归于观察者。', x: 'B版序言' },
    ],
  },
  {
    name: '感性论 · 时空与直观',
    terms: [
      { k: '直观', b: '直观', d: '直接与对象相关的认识；感性直观接受对象，其形式是时空。', x: '感性论' },
      { k: '纯直观', b: '纯直观', d: '不包含感觉、只包含形式的直观；空间与时间就是纯直观。', x: '感性论' },
      { k: '空间', b: '空间', d: '外感官的先天直观形式；几何学因此是先天综合的。', x: '感性论' },
      { k: '时间', b: '时间', d: '内感官的先天直观形式，一切现象（含内省）的直接条件；算术基于时间。', x: '感性论' },
      { k: '外感官', b: '外感官', d: '把对象表象为在空间中的能力。', x: '感性论' },
      { k: '内感官', b: '内感官', d: '把自我及其状态表象为在时间中的能力；时间比空间更根本。', x: '感性论' },
      { k: '经验实在性', b: '经验实在性', d: '时空在经验层面真实有效：现象中的对象确实在时空中有客观秩序。', x: '感性论' },
      { k: '先验观念性', b: '先验观念性', d: '时空作为直观形式只是主观的，不是物自体的属性；两者兼容，不是贝克莱。', x: '感性论' },
      { k: '现象', b: '现象', d: '被时空与范畴加工过的对象；我们唯一能认识的对象。', x: '全书' },
      { k: '物自体', b: '物自体', d: '现象背后的东西，不可知但可思；是限制概念，也是道德与自由的根据。', x: '全书' },
      { k: '反驳观念论', b: '反驳观念论', d: '证明外物存在：我意识到自己的时间规定，预设了外在持久实体作参照。', x: 'B版新增' },
    ],
  },
  {
    name: '分析论 · 知性与范畴',
    terms: [
      { k: '判断', b: '判断', d: '把表象带到统觉的统一之下的方式；一切思维最终都是判断。', x: '分析论' },
      { k: '判断表', b: '判断表', d: '四种形式各三种：量（全称/特称/单称）、质（肯定/否定/无限）、关系（直言/假言/选言）、模态（或然/实然/必然）。', x: '分析论' },
      { k: '范畴', b: '范畴', d: '纯粹知性概念，与判断形式一一对应的十二个先天概念；用于统一直观杂多。', x: '分析论' },
      { k: '范畴表', b: '范畴表', d: '量：单一/复多/全体；质：实在/否定/限制；关系：依存/因果/协同；模态：可能/现实/必然。', x: '分析论' },
      { k: '先验逻辑', b: '先验逻辑', d: '不仅管思维形式，还管思维如何与对象先天相关；区别于只管形式的一般逻辑。', x: '分析论' },
      { k: '综合', b: '综合', d: '把杂多联结起来的行为；认识离不开综合，范畴正是综合的先天规则。', x: '分析论' },
      { k: '领会的综合', b: '领会综合', d: '直观中把杂多聚拢为一瞥（看房子从上到下却把握为整体）。', x: 'A版演绎' },
      { k: '再生的综合', b: '再生综合', d: '想象中把过去的表象叫回（数数须记住前数）。', x: 'A版演绎' },
      { k: '认定的综合', b: '认定综合', d: '用概念认出"同一"对象；三重综合的完成。', x: 'A版演绎' },
      { k: '想象力', b: '想象力', d: '在直观与概念之间中介的官能，盲目但不可缺；A版主角，B版退居幕后。', x: '分析论' },
      { k: '统觉', b: '统觉', d: '自我意识的统一；"我思必须能伴随我一切表象"（B129-131）是知性的最高原理。', x: 'B版演绎' },
      { k: '先验演绎', b: '先验演绎', d: '证明范畴适用于一切可能经验的正当性；A版从下往上（三重综合），B版从上往下（统觉）。', x: '分析论' },
      { k: '图型', b: '图型', d: '先验的时间规定，是范畴与直观之间的中介；把范畴翻译成时间。', x: '图型法' },
      { k: '时间图型', b: '时间图型', d: '量=数、质=充实度、实体=持久、因果=有规则相继、协同=共存、模态=某时/确时/一切时。', x: '图型法' },
      { k: '原理体系', b: '原理体系', d: '范畴+图型=先天原理：直观公理、知觉预测、经验类比、经验思维公设。', x: '原理体系' },
      { k: '直观的公理', b: '直观公理', d: '一切直观都是外延的量——几何可应用于经验。', x: '原理体系' },
      { k: '知觉的预测', b: '知觉预测', d: '一切知觉对象都有内包的量（强度）——温度亮度有程度。', x: '原理体系' },
      { k: '经验的类比', b: '经验类比', d: '第一类比实体守恒、第二类比因果律、第三类比协同性——经验客观时间秩序的条件。', x: '原理体系' },
      { k: '经验思维的公设', b: '思维公设', d: '与现实经验条件相符者为可能/现实/必然；存在不是从概念推出的。', x: '原理体系' },
      { k: '先验对象', b: '先验对象X', d: '伴随现象的思维空位，不是实体，防把现象当物自体。', x: '分析论' },
      { k: '先验反省', b: '先验反省', d: '判断表象归属（感性还是知性）的意识；莱布尼茨、洛克都因缺乏它而两歧。', x: '两歧章' },
    ],
  },
  {
    name: '辩证论 · 理性与幻相',
    terms: [
      { k: '理性', b: '理性', d: '追求无条件总体的官能；与知性（只管规则）相对，理性管规则的统一。', x: '辩证论' },
      { k: '理念', b: '理念', d: '理性的纯粹概念：灵魂、世界、上帝；不构成知识，但有调节性用途。', x: '辩证论' },
      { k: '先验幻相', b: '先验幻相', d: '理性自然产生的、不可避免的假象（如海市蜃楼）；批判只能揭露不能根除。', x: '辩证论' },
      { k: '谬误推理', b: '谬误推理', d: '理性心理学从"我思"推出灵魂实体/单纯/人格/不朽的四重偷换。', x: '辩证论' },
      { k: '二律背反', b: '二律背反', d: '理性把世界当整体追问无条件者时，正反两方都能证明的冲突；共四组。', x: '辩证论' },
      { k: '数学的二律背反', b: '数学二律', d: '第一二律（世界有限/无限）、第二二律（单纯/可分）：皆假，因为现象无总体。', x: '辩证论' },
      { k: '力学的二律背反', b: '力学二律', d: '第三二律（自由/自然）、第四二律（必然/偶然）：皆真，分属现象与物自体两域。', x: '辩证论' },
      { k: '正题与反题', b: '正题/反题', d: '二律背反中两个对立的命题；双方论证都精彩，前提（世界是物自体整体）才错。', x: '辩证论' },
      { k: '理想', b: '理想', d: '理念中特殊的、关于最完满存在者的理念；理性自然趋向。', x: '辩证论' },
      { k: '存在不是谓词', b: '存在不是谓词', d: '存在不是实在属性，只是设定；100塔勒概念≠100塔勒现金，由此推翻本体论证明。', x: '辩证论' },
      { k: '本体论证明', b: '本体论证明', d: '从上帝概念推出上帝存在；被"存在不是谓词"击破。', x: '辩证论' },
      { k: '宇宙论证明', b: '宇宙论证明', d: '从偶然事物推必然存在者；暗中依赖本体论证明+超验使用因果。', x: '辩证论' },
      { k: '自然神学证明', b: '自然神学证明', d: '从自然合目的性推设计者；至多证建筑师，不能证全能全善的上帝。', x: '辩证论' },
      { k: '调节性使用', b: '调节性使用', d: '理念不构成知识，但指导知性追求体系性、统一性——有用的假定（如有设计）。', x: '辩证论' },
      { k: '构成性使用', b: '构成性使用', d: '范畴构成现象、产生知识；理念若被当成构成知识的概念就是幻相。', x: '辩证论' },
    ],
  },
  {
    name: '方法论 · 训练、法规与建筑术',
    terms: [
      { k: '训练', b: '训练', d: '纯粹理性的纪律：限制理性越界（定义/公理/证明/假设四纪律）。', x: '方法论' },
      { k: '法规', b: '法规', d: '理性在实践领域的法则（道德律）；认识领域只有训练无法规。', x: '方法论' },
      { k: '意见', b: '意见', d: '主观与客观都不充分的判断。', x: '方法论' },
      { k: '知识', b: '知识', d: '主观与客观都充分的判断。', x: '方法论' },
      { k: '信仰', b: '信仰', d: '主观充分、客观不充分的判断；道德信仰是理性的。', x: '方法论' },
      { k: '至善', b: '至善', d: '德性与配称的幸福；经验界无法实现，需要上帝与不朽作公设。', x: '方法论/第二批判' },
      { k: '建筑术', b: '建筑术', d: '知识成体系的艺术；理性的建筑本能追求系统而非堆积。', x: '方法论' },
      { k: '独断论', b: '独断论', d: '未经批判就建立体系（沃尔夫）；哲学史第一阶段。', x: '方法论' },
      { k: '怀疑论', b: '怀疑论', d: '休谟式的怀疑摧毁知识基础；哲学史第二阶段。', x: '方法论' },
      { k: '批判哲学', b: '批判哲学', d: '先审查能力再立界；哲学史的成熟阶段（独断→怀疑→批判）。', x: '方法论' },
    ],
  },
];
const total = groups.reduce((s, g) => s + g.terms.length, 0);
---

<Base title={title} current="/glossary/" badge={`${total}词分类速查`} searchPlaceholder="全站搜索：先天/统觉/二律…">
  <main class="container py-9">
    <PageHead
      chip={`术语库 · ${total}词 · 按批判哲学体系分类`}
      title="术语库 & 概念速查"
      subtitle="按「总纲→感性论→分析论→辩证论→方法论」的课程顺序分组，每条含一句话定义与关键区别；点击右上角搜索可定位对应句读。"
    />
    <div class="my-4">
      <input
        id="localFilter"
        placeholder="本地过滤术语：先天 统觉 图型 二律…"
        class="border border-line rounded-full px-4 py-2 w-full max-w-[400px] bg-card font-mono outline-none focus:border-accent2"
      />
    </div>

    {
      groups.map((g) => (
        <section class="mt-7">
          <div class="section-head" style="margin:0 0 14px">
            <div class="h3">{g.name} · {g.terms.length}词</div>
          </div>
          <div id="grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {
              g.terms.map((t) => (
                <div class="card p-4 gitem" data-k={t.k}>
                  <div class="flex items-baseline justify-between gap-2">
                    <b>{t.b}</b>
                    {t.x && <span class="font-mono text-[10px] text-muted">{t.x}</span>}
                  </div>
                  <p class="p text-[12.5px] mt-1.5">{t.d}</p>
                </div>
              ))
            }
          </div>
        </section>
      ))
    }

    <div class="card mt-8">
      <div class="h3">参考</div>
      <ul class="p text-[12.5px] leading-[1.9] mt-1" style="list-style:none;padding:0">
        <li>· 术语译法参考邓晓芒/杨祖陶译本与李秋零《康德著作全集》注释本（个别词如"现象/显象"两译并存）</li>
        <li>· <a href="https://plato.stanford.edu/entries/kant-transcendental-idealism/" target="_blank" rel="noopener" class="underline text-accent">SEP: Kant's Transcendental Idealism</a>（英文对照）</li>
      </ul>
    </div>
  </main>

  <script>
    const filter = document.getElementById('localFilter') as HTMLInputElement;
    filter?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase();
      document.querySelectorAll('.gitem').forEach((el) => {
        const elm = el as HTMLElement;
        elm.style.display = (elm.dataset.k + elm.textContent).toLowerCase().includes(q) ? '' : 'none';
      });
    });
  </script>
</Base>
