---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import SentenceReader from '../../components/SentenceReader.astro';
import { commentDB } from '../../lib/commentDB';
import { parseSentences } from '../../lib/parse';
import { CHAPTERS } from '../../lib/chapters';
import { DatabaseSync } from 'node:sqlite';
import path from 'node:path';
const title = '先验辩证论 · 导读：理性为何必然越界';

interface Item { key: string; ref: string; original: string; deng: string; tip: string }
const pick = (keys: string[]): Item[] => keys
  .map((k) => (commentDB[k] ? { key: k, ...commentDB[k] } : null))
  .filter((x): x is Item => x !== null);
const total = Object.keys(commentDB).filter((k) => k.startsWith('dia-')).length;

const ch = CHAPTERS.find((c) => c.key === 'dialectic')!;
interface ChunkRow { id: string; seq: number; chapter: string; text: string }
const clean = (s: string) => s.replace(/^[&$＄§#*\s]+/, '');
const db = new DatabaseSync(path.join(process.cwd(), 'data/kant.db'));
const raw = db.prepare('SELECT id, seq, chapter, text FROM chunks WHERE seq >= ? AND seq <= ? ORDER BY seq').all(ch.lo, ch.hi) as ChunkRow[];
db.close();
const sentences = raw.flatMap((r) => parseSentences(r.text, r.id, r.seq, { section: clean(r.chapter) }));
---

<Base title={title} current="/dialectic/" badge={`导读 · 全部${total}条见句读全库`} searchPlaceholder="搜索：谬误/二律/存在不是谓词…">
  <main class="container narrow py-9">
    <PageHead
      chip="Part C · 要素论第三部 · 导读"
      title="先验辩证论"
      subtitle="从灵魂到世界到上帝 — 理性为何必然越界，幻相如何被揭露"
    />

    <!-- 本章任务 -->
    <div class="card mt-5">
      <div class="h3 accent">本章任务 · 它要解决什么问题</div>
      <p class="p text-[13.5px]">知性用范畴立了法，但理性不满足于经验，它追求<b>无条件者</b>：灵魂（理性心理学）、世界整体（理性宇宙论）、上帝（理性神学）。辩证论证明：这些追求必然产生<b>先验幻相</b>——不是偶然错误，而是理性本性使然。批判的任务是揭露幻相、划定理性的合法界限，同时为实践理性（道德）留出地盘。</p>
      <div class="quote mt-3 text-xs">一句话：理性想要认识无条件者，但无条件者不是经验对象——认识划界，实践立界。</div>
    </div>

    <!-- 论证路线图 -->
    <div class="card mt-5">
      <div class="h3">论证路线图 · 三站</div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div class="step"><b>① 谬误推理</b><div>从"我思"推出灵魂实体/单纯/不朽——逻辑主词被偷换为实体，四重谬误。</div></div>
        <div class="step"><b>② 二律背反</b><div>把世界当整体问有限/无限等——正反皆可证。数学二律皆假，力学二律皆真分域。</div></div>
        <div class="step"><b>③ 上帝证明</b><div>本体论（存在不是谓词）、宇宙论（偷用本体论）、自然神学（至多证建筑师）——三种证明全部破产。</div></div>
      </div>
    </div>

    <!-- 二律背反速览 -->
    <div class="card mt-5">
      <div class="h3 accent">四组二律背反速览</div>
      <table class="table mt-2">
        <thead>
          <tr><th>组</th><th>正题</th><th>反题</th><th>解决</th></tr>
        </thead>
        <tbody>
          <tr><td><b>第一</b>（数学）</td><td>世界在时间空间上有限</td><td>世界无限</td><td>皆假（无总体）</td></tr>
          <tr><td><b>第二</b>（数学）</td><td>复合物由单纯部分构成</td><td>无单纯，无限可分</td><td>皆假（无总体）</td></tr>
          <tr><td><b>第三</b>（力学）</td><td>除自然因果外还有自由</td><td>无自由，皆自然因果</td><td>皆真（分属现象/物自体）</td></tr>
          <tr><td><b>第四</b>（力学）</td><td>有绝对必然存在者</td><td>无必然，一切偶然</td><td>皆真（分属现象/物自体）</td></tr>
        </tbody>
      </table>
      <div class="quote mt-3 text-xs">邓晓芒要点：数学二律把"世界整体"当成已完成的总体去问有限无限——预设错，故皆假；力学二律把自由/必然放在现象界与物自体两个层面——不冲突，故皆真，为道德留出地盘。</div>
    </div>

    <!-- 核心句读精选 -->
    <div class="section-head" style="margin:28px 0 12px">
      <div class="h3">核心句读精选 · 读懂本章的关键句</div>
      <span class="font-mono text-[10px] text-muted">完整 {total} 条见 <a href="/deng/" class="underline">句读全库</a></span>
    </div>

    <div class="card mt-3">
      <div class="h3">理念与幻相 · 总论</div>
      {
        pick(['dia-ide-logic', 'dia-illusion', 'dia-idea-soul', 'dia-idea-world', 'dia-idea-god']).map((it) => (
          <div class="my-2">
            <div class="font-mono text-[10px] text-muted">{it.ref}</div>
            <div class="serif font-bold my-1">「{it.original}」</div>
            <div class="p text-[13px]">{it.deng}</div>
          </div>
        ))
      }
    </div>

    <div class="card mt-4">
      <div class="h3">谬误推理 · 灵魂</div>
      {
        pick(['dia-para-1', 'dia-para-2', 'dia-para-4']).map((it) => (
          <div class="my-2">
            <div class="font-mono text-[10px] text-muted">{it.ref}</div>
            <div class="serif font-bold my-1">「{it.original}」</div>
            <div class="p text-[13px]">{it.deng}</div>
          </div>
        ))
      }
    </div>

    <div class="card mt-4">
      <div class="h3">二律背反 · 世界</div>
      {
        pick(['dia-anti1-thesis', 'dia-anti1-antith', 'dia-anti1-res', 'dia-anti3-thesis', 'dia-anti3-res']).map((it) => (
          <div class="my-2">
            <div class="font-mono text-[10px] text-muted">{it.ref}</div>
            <div class="serif font-bold my-1">「{it.original}」</div>
            <div class="p text-[13px]">{it.deng}</div>
          </div>
        ))
      }
    </div>

    <div class="card mt-4">
      <div class="h3">上帝 · 三证明批判</div>
      {
        pick(['dia-onto-refutation', 'dia-onto-100thaler', 'dia-cosmo', 'dia-physico', 'dia-regulative']).map((it) => (
          <div class="my-2">
            <div class="font-mono text-[10px] text-muted">{it.ref}</div>
            <div class="serif font-bold my-1">「{it.original}」</div>
            <div class="p text-[13px]">{it.deng}</div>
          </div>
        ))
      }
    </div>

    <!-- 逐句助读 · 康德原文 + 邓晓芒讲解 -->
    <div class="section-head" style="margin:28px 0 12px">
      <div class="h3">逐句助读 · {ch.title} · {sentences.length}句</div>
      <span class="font-mono text-[10px] text-muted">一句康德原文，配一段邓晓芒讲解</span>
    </div>
    <SentenceReader sentences={sentences} />

    <!-- 疑难辨析 -->
    <div class="card mt-6" style="background:linear-gradient(180deg,var(--color-card),var(--color-bg2))">
      <div class="h3 accent">常见疑难辨析</div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <b>① "为什么正题反题都能证明？"</b>
          <p class="p text-[13px] mt-1">因为"世界整体"本身不是经验对象。正题从"整体已完成"推，反题从"整体未完成"推——两个证明都严谨，错在共同前提：把世界当作物自体那样的已完成总体。</p>
        </div>
        <div>
          <b>② "存在不是谓词"到底什么意思？</b>
          <p class="p text-[13px] mt-1">"存在"不增加概念的任何内容：想象中 100 塔勒与现实 100 塔勒，概念完全相同，区别只在"被设定"。所以从"上帝概念"推不出"上帝存在"。</p>
        </div>
        <div>
          <b>③ "康德否定上帝存在吗？"</b>
          <p class="p text-[13px] mt-1">不否定，只否定"认识上能证明"。认识上上帝不可知，但实践上可作为道德公设——这正是《实践理性批判》的入口。</p>
        </div>
        <div>
          <b>④ "理念就完全没用吗？"</b>
          <p class="p text-[13px] mt-1">有用。理念作为<b>调节性</b>原则指导科学研究："仿佛"自然有统一设计，促使我们追求更系统的知识——只是不能当作构成性知识。</p>
        </div>
        <div>
          <b>⑤ "谬误推理的根源是什么？"</b>
          <p class="p text-[13px] mt-1">把"我思"这个逻辑上的主词当成了本体上的实体。从"我能作主词"（逻辑）推到"我是实体"（本体）——中项被偷换，四重谬误（实体/单纯/人格/观念性）同源。</p>
        </div>
        <div>
          <b>⑥ "数学二律和力学二律为什么解法不同？"</b>
          <p class="p text-[13px] mt-1">数学二律（有限/无限、单纯/可分）把世界当成已完成总体去问——皆假，因为现象无总体；力学二律（自由/必然）讨论的是关系性概念，可放在现象界与物自体两个层面——皆真，各得其所。</p>
        </div>
      </div>
    </div>

    <!-- 参考来源 -->
    <div class="card mt-6">
      <div class="h3">参考来源</div>
      <ul class="p text-[12.5px] leading-[1.9] mt-1" style="list-style:none;padding:0">
        <li>· <a href="https://plato.stanford.edu/entries/kant-reason/" target="_blank" rel="noopener" class="underline text-accent">SEP: Kant's Account of Reason</a></li>
        <li>· <a href="https://plato.stanford.edu/entries/kant-antinomies/" target="_blank" rel="noopener" class="underline text-accent">SEP: Kant's Antinomies of Pure Reason</a></li>
        <li>· <a href="https://plato.stanford.edu/entries/ontological-arguments/" target="_blank" rel="noopener" class="underline text-accent">SEP: Ontological Arguments</a></li>
        <li>· 邓晓芒《纯粹理性批判》句读（辩证论部分）· 李秋零《康德著作全集》注释本</li>
      </ul>
    </div>

    <div class="flex flex-wrap gap-3 mt-6">
      <a href="/analytic/" class="pill">← 分析论</a>
      <a href="/deng/" class="pill">句读全库 全部{total}条 →</a>
      <a href="/method/" class="pill">下一章 方法论 →</a>
    </div>
  </main>
</Base>
