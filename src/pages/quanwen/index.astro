---
import Base from '../../layouts/Base.astro';
import { DatabaseSync } from 'node:sqlite';
import path from 'node:path';
const title = '邓晓芒句读 全文阅览 2381页 | SQLite 直读版';

interface Chunk { id: string; start: number; end: number; text: string; title: string }
// 构建时从 SQLite 数据库读取全文（data/kant.db），运行时不依赖 JSON / wasm
const db = new DatabaseSync(path.join(process.cwd(), 'data/kant.db'));
const rawChunks: Chunk[] = db.prepare('SELECT id, start_page AS start, end_page AS end, text FROM chunks').all() as Chunk[];
db.close();
// PDF 提取文本每行都带硬换行：先折叠为空格，再去掉中文之间的空格，得到连续段落
const chunks: Chunk[] = rawChunks.map((c) => ({
  ...c,
  text: c.text.replace(/\s*\n\s*/g, ' ').replace(/([\u4e00-\u9fff])\s+([\u4e00-\u9fff])/g, '$1$2').trim(),
}));
const totalPages = 2381;
const totalChars = chunks.reduce((s, c) => s + c.text.length, 0);
---

<Base title={title} current="/quanwen/" badge="全文阅览 2381页" searchPlaceholder="全站搜索：存在不是谓词/统觉…">
  <main class="max-w-[1440px] mx-auto px-5 py-7">
    <div class="chip">FULL TEXT · PDF 全文直读 · {chunks.length}段 · {totalPages}页 · {totalChars.toLocaleString()}字</div>
    <h1 class="serif text-4xl mt-3 mb-1">
      邓晓芒《纯粹理性批判》句读 · 全文
    </h1>

    <div id="body">
      {
        chunks.map((c) => (
          <div class="card my-3" id={`c${c.start}`} data-pt={c.start} data-text={c.text}>
            <div class="flex items-center gap-2">
              <span class="tag font-mono text-[10px]">页 {c.start}-{c.end}</span>
              <span class="font-mono text-[10px] text-muted">#{c.id}</span>
            </div>
            <div class="serif text-[17px] leading-[2.05] mt-2.5 whitespace-normal">{c.text}</div>
          </div>
        ))
      }
    </div>

    <div id="pagerBottom" class="float-pager">
      <button id="prevB" class="toggle">← 上一页</button>
      <span class="font-mono text-xs text-muted">第 <b id="pageNumB" class="text-ink">1</b> / <span id="pageTotalB">--</span> 页</span>
      <button id="nextB" class="toggle">下一页 →</button>
      <span class="w-px self-stretch bg-line"></span>
      <input id="jumpInput" type="number" min="1" max="2381" placeholder="页码 如 500" class="w-[110px] border border-line rounded-full px-3 py-1.5 bg-bg2 font-mono text-sm outline-none focus:border-accent2 transition-colors" />
      <button id="jumpBtn" class="toggle">跳转</button>
      <span id="jumpHint" class="font-mono text-[11px] text-muted max-w-[160px] truncate"></span>
    </div>
  </main>

  <script>
    const PAGE = 15;
    const cards = Array.from(document.querySelectorAll('#body .card')) as HTMLElement[];
    const totalPages = Math.ceil(cards.length / PAGE);
    let page = 1;

    function syncPageUI() {
      const set = (n: HTMLElement | null, t: HTMLElement | null) => {
        if (n) n.textContent = String(page);
        if (t) t.textContent = String(totalPages);
      };
      set(document.getElementById('pageNumB'), document.getElementById('pageTotalB'));
    }

    function applyPage() {
      cards.forEach((card, i) => {
        const show = i >= (page - 1) * PAGE && i < page * PAGE;
        card.style.display = show ? '' : 'none';
      });
      syncPageUI();
    }

    function goPage(p: number) {
      page = Math.min(Math.max(1, p), totalPages);
      applyPage();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function gotoStart(start: string) {
      const card = document.getElementById(`c${start}`);
      if (!card) return;
      const i = cards.indexOf(card as HTMLElement);
      if (i === -1) return;
      page = Math.floor(i / PAGE) + 1;
      applyPage();
      requestAnimationFrame(() => {
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
        card.classList.add('flash');
        setTimeout(() => card.classList.remove('flash'), 2000);
      });
    }

    // 按原书页码跳转
    function jumpToBookPage(p: number) {
      const q = p;
      // 找到包含该页码的段落卡片
      const card = cards.find((c) => {
        const pt = parseInt(c.dataset.pt ?? '', 10);
        return pt <= q && q < pt + 3;
      });
      const hint = document.getElementById('jumpHint') as HTMLElement;
      if (!card) {
        if (hint) hint.textContent = `未找到页 ${q}`;
        return;
      }
      if (hint) hint.textContent = `已定位到 页 ${q}（段落 #${card.id}）`;
      gotoStart(String((card.dataset.pt ?? '')));
    }

    // 分页按钮
    document.getElementById('prevB')?.addEventListener('click', () => goPage(page - 1));
    document.getElementById('nextB')?.addEventListener('click', () => goPage(page + 1));

    // 书页跳转
    const jumpInput = document.getElementById('jumpInput') as HTMLInputElement;
    const jumpBtn = document.getElementById('jumpBtn') as HTMLButtonElement;
    const doJump = () => {
      const p = parseInt(jumpInput.value, 10);
      if (p >= 1 && p <= 2381) jumpToBookPage(p);
    };
    jumpBtn?.addEventListener('click', doJump);
    jumpInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') doJump();
    });

    // 键盘翻页（排除输入框内按键）
    document.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement).tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      if (e.key === 'ArrowLeft') goPage(page - 1);
      if (e.key === 'ArrowRight') goPage(page + 1);
    });

    // 初始
    applyPage();
  </script>

  <style>
    .card.flash {
      outline: 2px solid var(--color-accent2);
      outline-offset: 4px;
      transition: outline-color 0.2s;
    }
    .float-pager {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 60;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 18px;
      border-radius: 999px;
      background: var(--color-card);
      border: 1px solid var(--color-line);
      box-shadow: 0 14px 44px rgba(16, 41, 71, 0.16);
      max-width: calc(100vw - 24px);
      overflow-x: auto;
    }
    @media (max-width: 640px) {
      .float-pager #jumpHint,
      .float-pager .bg-line {
        display: none;
      }
      .float-pager #jumpInput {
        width: 84px;
      }
    }
    main {
      padding-bottom: 96px;
    }
  </style>
</Base>
