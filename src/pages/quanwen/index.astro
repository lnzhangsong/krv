---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { DatabaseSync } from 'node:sqlite';
import path from 'node:path';
import { SEQ_COUNT } from '../../lib/chapters';
import { wrapTerms } from '../../lib/glossary';
const title = '邓晓芒句读 全文阅览 7594段 | SQLite 直读版';

interface Chunk { id: string; seq: number; chapter: string; text: string }
// 构建时从 SQLite 数据库读取全文（data/kant.db），运行时不依赖 JSON / wasm
const db = new DatabaseSync(path.join(process.cwd(), 'data/kant.db'));
const chunks: Chunk[] = db.prepare('SELECT id, seq, chapter, text FROM chunks ORDER BY seq').all() as Chunk[];
db.close();
const totalChars = chunks.reduce((s, c) => s + c.text.length, 0);

const PAGE = 15;
const firstPage = chunks.slice(0, PAGE);

// 将【】内的康德原文用高亮标记包裹，与邓晓芒讲解区分
function highlightKant(text: string): string {
  return text.replace(/【([^】]+)】/g, '<b class="kant-q">「$1」</b>');
}

// 全文以 JSON 嵌入，客户端按页渲染，避免一次性渲染 7594 段造成 DOM 过大
const chunksJson = JSON.stringify(chunks.map((c) => ({ id: c.id, seq: c.seq, chapter: c.chapter, text: c.text }))).replace(/</g, '\\u003c');
---

<Base title={title} current="/quanwen/" badge="全文阅览 7594段" searchPlaceholder="全站搜索：存在不是谓词/统觉…">
  <main class="container narrow py-7">
    <PageHead
      chip={`FULL TEXT · 全文直读 · ${chunks.length}段 · ${totalChars.toLocaleString()}字`}
      title="邓晓芒《纯粹理性批判》句读 · 全文"
    />

    <div id="body" class="read-flow">
      {
        firstPage.map((c, i) => {
          const prev = i > 0 ? firstPage[i - 1] : null;
          const newChapter = !prev || prev.chapter !== c.chapter;
          return (
            <div class="rf-item" id={`c${c.seq}`} data-pt={c.seq} data-text={c.text}>
              {newChapter && (
                <div class="rf-chapter">
                  <span class="rf-chapter-mark"></span>
                  {c.chapter}
                </div>
              )}
              <div class="rf-text serif" set:html={highlightKant(wrapTerms(c.text))} />
              <span class="rf-page" title={`段 ${c.id}`}>{c.seq + 1}</span>
            </div>
          );
        })
      }
    </div>

    <div id="pagerBottom" class="float-pager">
      <button id="prevB" class="toggle">← 上一段</button>
      <span class="font-mono text-xs text-muted">第 <b id="pageNumB" class="text-ink">1</b> / <span id="pageTotalB">--</span> 段</span>
      <button id="nextB" class="toggle">下一段 →</button>
      <span class="w-px self-stretch bg-line"></span>
      <input id="jumpInput" type="number" min="1" max={SEQ_COUNT} placeholder="段号 如 500" class="w-[110px] border border-line rounded-full px-3 py-1.5 bg-bg2 font-mono text-sm outline-none focus:border-accent2 transition-colors" />
      <button id="jumpBtn" class="toggle">跳转</button>
      <span id="jumpHint" class="font-mono text-[11px] text-muted max-w-[160px] truncate"></span>
    </div>
  </main>

  <script is:inline type="application/json" id="qdata" set:html={chunksJson}></script>

  <script>
    import { wrapTerms } from '../../lib/glossary';
    const PAGE = 15;
    const dataEl = document.getElementById('qdata') as HTMLScriptElement | null;
    const chunks: { id: string; seq: number; chapter: string; text: string }[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
    const totalPages = Math.max(1, Math.ceil(chunks.length / PAGE));
    let page = 1;

    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const highlightKant = (text: string) => text.replace(/【([^】]+)】/g, '<b class="kant-q">「$1」</b>');

    const itemHTML = (c: { id: string; seq: number; chapter: string; text: string }, newChapter: boolean) => {
      const chapter = newChapter ? `<div class="rf-chapter"><span class="rf-chapter-mark"></span>${esc(c.chapter)}</div>` : '';
      return `<div class="rf-item" id="c${c.seq}" data-pt="${c.seq}" data-text="${esc(c.text)}">${chapter}<div class="rf-text serif">${highlightKant(wrapTerms(c.text))}</div><span class="rf-page" title="段 ${c.id}">${c.seq + 1}</span></div>`;
    };

    const body = document.getElementById('body') as HTMLElement | null;
    const chapterOf = (el: HTMLElement) => {
      const ch = el.querySelector('.rf-chapter');
      return ch ? ch.textContent : '';
    };

    function renderPage(p: number) {
      if (!body) return;
      const lo = (p - 1) * PAGE;
      const html = chunks
        .slice(lo, lo + PAGE)
        .map((c, i) => {
          const gi = lo + i;
          const prev = gi > 0 ? chunks[gi - 1] : null;
          return itemHTML(c, !prev || prev.chapter !== c.chapter);
        })
        .join('');
      body.innerHTML = html;
      syncPageUI();
    }

    function syncPageUI() {
      const set = (n: HTMLElement | null, t: HTMLElement | null) => {
        if (n) n.textContent = String(page);
        if (t) t.textContent = String(totalPages);
      };
      set(document.getElementById('pageNumB'), document.getElementById('pageTotalB'));
    }

    function goPage(p: number) {
      page = Math.min(Math.max(1, p), totalPages);
      renderPage(page);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function gotoStart(seq: number) {
      const idx = chunks.findIndex((c) => c.seq === seq);
      if (idx === -1) return;
      page = Math.floor(idx / PAGE) + 1;
      renderPage(page);
      const card = document.getElementById(`c${seq}`);
      if (card) {
        requestAnimationFrame(() => {
          card.scrollIntoView({ behavior: 'smooth', block: 'start' });
          card.classList.add('flash');
          setTimeout(() => card.classList.remove('flash'), 2000);
        });
      }
    }

    // 按段号跳转（输入 1-based 段号 → data-pt 是 0-based seq）
    function jumpToSeq(q: number) {
      const hint = document.getElementById('jumpHint') as HTMLElement | null;
      const seq = q - 1;
      const c = chunks.find((x) => x.seq === seq);
      if (!c) {
        if (hint) hint.textContent = `未找到段 ${q}`;
        return;
      }
      if (hint) hint.textContent = `已定位到 段 ${q}（${c.chapter || ''}）`;
      gotoStart(seq);
    }

    // 顶部阅读进度条 + 当前章节指示
    const progressWrap = document.createElement('div');
    progressWrap.className = 'rf-progress';
    progressWrap.innerHTML = '<div class="rf-progress-bar"></div>';
    document.body.appendChild(progressWrap);
    const progressBar = progressWrap.querySelector('.rf-progress-bar') as HTMLElement;

    // 用 rAF 节流，避免滚动时每帧触发布局写入
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        const pct = max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0;
        progressBar.style.width = pct + '%';
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();

    // 分页按钮
    document.getElementById('prevB')?.addEventListener('click', () => goPage(page - 1));
    document.getElementById('nextB')?.addEventListener('click', () => goPage(page + 1));

    // 段号跳转
    const jumpInput = document.getElementById('jumpInput') as HTMLInputElement | null;
    const jumpBtn = document.getElementById('jumpBtn') as HTMLButtonElement | null;
    const doJump = () => {
      const p = parseInt(jumpInput?.value || '', 10);
      if (p >= 1 && p <= chunks.length) jumpToSeq(p);
    };
    jumpBtn?.addEventListener('click', doJump);
    jumpInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') doJump();
    });

    // 键盘翻页（排除输入框内按键）
    document.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement).tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      if (e.key === 'ArrowLeft') goPage(page - 1);
      if (e.key === 'ArrowRight') goPage(page + 1);
    });

    // 初始：由客户端按页渲染（SSR 首屏仅第一页）
    renderPage(1);

    // 定位：reader「定位全文 →」链接形如 /quanwen/#c{seq}（seq 为 0 基）
    const initHash = location.hash.match(/^#c(\d+)/);
    if (initHash) {
      const seq = parseInt(initHash[1], 10);
      if (!Number.isNaN(seq)) {
        requestAnimationFrame(() => jumpToSeq(seq + 1));
      }
    }
  </script>

  <style>
    .rf-item.flash {
      background: color-mix(in srgb, var(--color-accent2) 18%, transparent);
      border-radius: 6px;
      transition: background-color 0.3s;
    }
    /* 中文书籍式连续排版：首行缩进、无分隔线、段号淡色 */
    .read-flow {
      padding: 12px 0 96px;
    }
    .rf-item {
      position: relative;
      padding: 0 0 0.9em;
    }
    .rf-chapter {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.05em;
      margin: 2.4em 0 0.9em;
      color: var(--color-accent);
      display: flex;
      align-items: center;
      gap: 10px;
      text-indent: 0;
    }
    .rf-chapter-mark {
      width: 4px;
      height: 1.1em;
      border-radius: 2px;
      background: var(--color-accent2);
      flex-shrink: 0;
    }
    .rf-chapter + .rf-text {
      margin-top: 0.1em;
    }
    .rf-text {
      font-size: 18px;
      line-height: 2.05;
      letter-spacing: 0.02em;
      color: var(--color-ink);
      text-align: justify;
      text-indent: 2em;
    }
    /* 康德原文高亮：与句读原文的视觉语言一致（蓝色系） */
    .rf-text .kant-q {
      color: var(--color-accent);
      font-weight: 700;
      background: color-mix(in srgb, var(--color-accent) 7%, transparent);
      border-bottom: 2px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
      border-radius: 3px;
      padding: 0 2px;
      text-indent: 0;
    }
    .rf-text .kant-q:hover {
      background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    }
    .rf-page {
      display: none;
    }
    /* 顶部阅读进度条 */
    .rf-progress {
      position: fixed;
      top: 68px;
      left: 0;
      right: 0;
      height: 3px;
      z-index: 80;
      pointer-events: none;
    }
    .rf-progress-bar {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--color-accent) 0%, var(--color-accent2) 100%);
      transition: width 0.08s linear;
      border-radius: 0 3px 3px 0;
    }
    .float-pager {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 60;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 18px;
      border-radius: 999px;
      background: var(--color-card);
      border: 1px solid var(--color-line);
      box-shadow: 0 14px 44px rgba(16, 41, 71, 0.16);
      max-width: calc(100vw - 24px);
      overflow-x: auto;
    }
    @media (max-width: 640px) {
      .float-pager #jumpHint,
      .float-pager .bg-line {
        display: none;
      }
      .float-pager #jumpInput {
        width: 84px;
      }
    }
  </style>
</Base>
