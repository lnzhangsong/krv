---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { DatabaseSync } from 'node:sqlite';
import path from 'node:path';
import { SEQ_COUNT } from '../../lib/chapters';
import { wrapTerms } from '../../lib/glossary';
const title = '邓晓芒句读 全文阅览 7594段 | SQLite 直读版';

interface Chunk { id: string; seq: number; chapter: string; text: string }
// 构建时从 SQLite 数据库读取全文（data/kant.db），运行时不依赖 JSON / wasm
const db = new DatabaseSync(path.join(process.cwd(), 'data/kant.db'));
const chunks: Chunk[] = db.prepare('SELECT id, seq, chapter, text FROM chunks ORDER BY seq').all() as Chunk[];
db.close();
const totalChars = chunks.reduce((s, c) => s + c.text.length, 0);

const PAGE = 15;
const firstPage = chunks.slice(0, PAGE);

// 将【】内的康德原文用高亮标记包裹，与邓晓芒讲解区分
function highlightKant(text: string): string {
  return text.replace(/【([^】]+)】/g, '<b class="kant-q">「$1」</b>');
}

// 全文数据不内嵌 HTML：构建期按页生成 /fulltext/page-N.json，客户端懒加载索引 + 按页取数
---

<Base title={title} current="/quanwen/" badge="全文阅览 7594段" searchPlaceholder="全站搜索：存在不是谓词/统觉…">
  <main class="container narrow py-7">
    <PageHead
      chip={`FULL TEXT · 全文直读 · ${chunks.length}段 · ${totalChars.toLocaleString()}字`}
      title="邓晓芒《纯粹理性批判》句读 · 全文"
    />

    <div class="rf-toolbar">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="rf-toolbar-label">字号</span>
        <button id="fsMinus" class="toggle" title="缩小字号">A−</button>
        <button id="fsReset" class="toggle on" title="默认字号">A</button>
        <button id="fsPlus" class="toggle" title="放大字号">A+</button>
        <button id="lhBtn" class="toggle" title="调节行距">行距:标</button>
        <span class="w-px self-stretch bg-line"></span>
        <select id="chapterJump" class="rf-select" aria-label="跳转章节"></select>
        <span id="nowChapter" class="rf-now"></span>
        <span class="w-px self-stretch bg-line"></span>
        <span class="relative inline-flex">
          <button id="bmBtn" class="toggle" title="我的书签">书签 ★</button>
          <div id="bmList" class="rf-bm-list" hidden></div>
        </span>
      </div>
    </div>

    <div id="body" class="read-flow">
      {
        firstPage.map((c, i) => {
          const prev = i > 0 ? firstPage[i - 1] : null;
          const newChapter = !prev || prev.chapter !== c.chapter;
          return (
            <div class="rf-item" id={`c${c.seq}`} data-pt={c.seq} data-text={c.text}>
              {newChapter && (
                <div class="rf-chapter">
                  <span class="rf-chapter-mark"></span>
                  {c.chapter}
                </div>
              )}
              <div class="rf-text serif" set:html={highlightKant(wrapTerms(c.text))} />
              <span class="rf-page" title={`段 ${c.id}`}>{c.seq + 1}</span>
            </div>
          );
        })
      }
    </div>

    <div id="pagerBottom" class="float-pager">
      <button id="prevB" class="toggle">← 上一段</button>
      <span class="font-mono text-xs text-muted">第 <b id="pageNumB" class="text-ink">1</b> / <span id="pageTotalB">--</span> 段</span>
      <button id="nextB" class="toggle">下一段 →</button>
      <span class="w-px self-stretch bg-line"></span>
      <input id="jumpInput" type="number" min="1" max={SEQ_COUNT} placeholder="段号 如 500" class="w-[110px] border border-line rounded-full px-3 py-1.5 bg-bg2 font-mono text-sm outline-none focus:border-accent2 transition-colors" />
      <button id="jumpBtn" class="toggle">跳转</button>
      <span id="jumpHint" class="font-mono text-[11px] text-muted max-w-[160px] truncate"></span>
    </div>
  </main>

  <script>
    import { wrapTerms } from '../../lib/glossary';
    import { loadHls, saveHls, loadNotes, saveNotes, loadBms, saveBms, findRange, loadPos, savePos, FS_KEY, LH_KEY } from '../../lib/reading';
    // 延迟初始化：让 SSR 首屏先绘制，再按页加载全文数据
    const init = () => {
    const PAGE = 15;
    // 全文分片：/fulltext/index.json 轻量索引 + /fulltext/page-N.json 按页数据（不再下载 6MB 全量）
    let totalPages = 1;
    let total = 0;
    let page = 1;
    let dataReadyFlag = false; // 索引就绪
    let curData: { page: number; prevChapter: string; chunks: { id: string; seq: number; chapter: string; text: string }[] } | null = null;
    const hintEl = document.getElementById('jumpHint') as HTMLElement | null;
    const needData = (fn: (...a: any[]) => void) => (...a: any[]) => {
      if (!dataReadyFlag) { if (hintEl) hintEl.textContent = '全文加载中…'; return; }
      fn(...a);
    };

    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const highlightKant = (text: string) => text.replace(/【([^】]+)】/g, '<b class="kant-q">「$1」</b>');

    // 学习闭环状态
    let hls = loadHls();
    let notes = loadNotes();
    let bms = loadBms();
    const bmSet = new Set(bms.map((b) => b.seq));
    const noteMap = new Map(notes.map((n) => [n.seq, n]));

    const itemHTML = (c: { id: string; seq: number; chapter: string; text: string }, newChapter: boolean) => {
      const chapter = newChapter ? `<div class="rf-chapter"><span class="rf-chapter-mark"></span>${esc(c.chapter)}</div>` : '';
      const isBm = bmSet.has(c.seq);
      const note = noteMap.get(c.seq);
      return `<div class="rf-item" id="c${c.seq}" data-pt="${c.seq}" data-text="${esc(c.text)}">
        ${chapter}
        <div class="rf-acts">
          <button class="rf-act ${isBm ? 'on' : ''}" data-act="bm" data-seq="${c.seq}" title="${isBm ? '取消收藏' : '收藏本段'}">${isBm ? '★' : '☆'}</button>
          <button class="rf-act ${note ? 'on' : ''}" data-act="note" data-seq="${c.seq}" title="${note ? '编辑批注' : '添加批注'}">${note ? '📝' : '✎'}</button>
        </div>
        <div class="rf-text serif">${highlightKant(wrapTerms(c.text))}</div>
        ${note ? `<div class="rf-note-view" data-seq="${c.seq}">💬 ${esc(note.note)}</div>` : ''}
        <span class="rf-page" title="段 ${c.id}">${c.seq + 1}</span>
      </div>`;
    };

    const body = document.getElementById('body') as HTMLElement | null;

    // 高亮：CSS Custom Highlight API（基于当前页 DOM）
    const hlHighlight = new Highlight();
    try { (CSS as unknown as { highlights: { set: (n: string, h: Highlight) => void } }).highlights.set('krv-hl', hlHighlight); } catch { /* 不支持时静默 */ }
    const applyHl = () => {
      try {
        hlHighlight.clear();
        if (!curData) return;
        const seqs = new Set(curData.chunks.map((c) => c.seq));
        for (const h of hls) {
          if (!seqs.has(h.seq)) continue;
          const el = document.getElementById('c' + h.seq);
          if (!el) continue;
          const r = findRange(el, h.text);
          if (r) hlHighlight.add(r);
        }
      } catch { /* ignore */ }
    };

    // ---- 分片加载：页数据缓存 + 相邻页预取 ----
    const pageOfSeq = (seq: number) => Math.min(totalPages, Math.max(1, Math.floor(seq / PAGE) + 1));
    const pageCache = new Map<number, Promise<{ page: number; prevChapter: string; chunks: { id: string; seq: number; chapter: string; text: string }[] }>>();
    const fetchPage = (p: number) => {
      const target = Math.min(Math.max(1, p), totalPages);
      let pr = pageCache.get(target);
      if (!pr) {
        pr = fetch(`/fulltext/page-${target}.json`).then((r) => { if (!r.ok) throw new Error('bad status'); return r.json(); });
        pageCache.set(target, pr);
      }
      return pr;
    };
    const prefetchPage = (p: number) => {
      if (p < 1 || p > totalPages || pageCache.has(p)) return;
      fetchPage(p).catch(() => { pageCache.delete(p); });
    };
    let loadSeq = 0;
    const loadPage = async (p: number): Promise<boolean> => {
      const target = Math.min(Math.max(1, p), totalPages);
      const my = ++loadSeq;
      try {
        const data = await fetchPage(target);
        if (my !== loadSeq) return false; // 已有更新的加载请求，忽略本次
        curData = data;
        page = target;
        return true;
      } catch {
        if (my === loadSeq && hintEl) hintEl.textContent = '页面加载失败';
        return false;
      }
    };

    function renderCurPage() {
      if (!body || !curData) return;
      const chunks = curData.chunks;
      const html = chunks
        .map((c, i) => {
          const prev = i > 0 ? chunks[i - 1] : null;
          const newChapter = i === 0 ? (curData.prevChapter ? c.chapter !== curData.prevChapter : true) : prev!.chapter !== c.chapter;
          return itemHTML(c, newChapter);
        })
        .join('');
      body.innerHTML = html;
      applyHl();
      syncPageUI();
      renderBmList();
      const cur = chunks[0];
      if (cur) savePos(cur.seq);
      if (nowChapter && cur) {
        nowChapter.textContent = cleanChapter(cur.chapter);
        if (chapterSelect) chapterSelect.value = String(chapterSeqMap.get(cur.chapter) ?? '');
      }
      // 后台预载本页文楷字形（不阻塞显示）
      try {
        if (document.fonts && document.fonts.load) {
          const pt = chunks.map((c) => c.text).join('');
          document.fonts.load('16px "LXGW WenKai"', pt);
          document.fonts.load('700 16px "LXGW WenKai"', pt);
        }
      } catch { /* ignore */ }
      // 预取相邻页
      prefetchPage(page + 1);
      prefetchPage(page - 1);
    }

    function syncPageUI() {
      const set = (n: HTMLElement | null, t: HTMLElement | null) => {
        if (n) n.textContent = String(page);
        if (t) t.textContent = String(totalPages);
      };
      set(document.getElementById('pageNumB'), document.getElementById('pageTotalB'));
    }

    async function goPage(p: number) {
      const target = Math.min(Math.max(1, p), totalPages);
      if (target === page && curData) { window.scrollTo({ top: 0, behavior: 'smooth' }); return; }
      const ok = await loadPage(target);
      if (!ok) return;
      renderCurPage();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function gotoStart(seq: number, flash = true) {
      if (seq < 0 || seq >= total) return;
      void loadPage(pageOfSeq(seq)).then((ok) => {
        if (!ok) return;
        renderCurPage();
        const card = document.getElementById(`c${seq}`);
        if (card) {
          requestAnimationFrame(() => {
            card.scrollIntoView({ behavior: 'smooth', block: 'start' });
            // 高亮定位仅用于用户主动跳转；恢复上次阅读位置时不闪
            if (flash) {
              card.classList.remove('flash');
              void card.offsetWidth; // 强制重排，确保连续跳转时动画重新触发
              card.classList.add('flash');
              setTimeout(() => card.classList.remove('flash'), 1700);
            }
          });
        }
      });
    }

    // 按段号跳转（输入 1-based 段号 → data-pt 是 0-based seq）
    const chapterNameOf = (seq: number) => {
      let name = '';
      for (const [n, s] of chapterSeqMap) { if (s <= seq) name = n; else break; }
      return name;
    };
    function jumpToSeq(q: number) {
      const seq = q - 1;
      if (seq < 0 || seq >= total) {
        if (hintEl) hintEl.textContent = `未找到段 ${q}`;
        return;
      }
      if (hintEl) hintEl.textContent = `已定位到 段 ${q}${chapterNameOf(seq) ? `（${chapterNameOf(seq)}）` : ''}`;
      gotoStart(seq);
    }

    // 顶部阅读进度条 + 当前章节指示
    const progressWrap = document.createElement('div');
    progressWrap.className = 'rf-progress';
    progressWrap.innerHTML = '<div class="rf-progress-bar"></div>';
    document.body.appendChild(progressWrap);
    const progressBar = progressWrap.querySelector('.rf-progress-bar') as HTMLElement;

    // 用 rAF 节流，避免滚动时每帧触发布局写入
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        const pct = max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0;
        progressBar.style.width = pct + '%';
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();

    // 字号调节
    const FS_SIZES = [16, 18, 20];
    let fs = parseInt(localStorage.getItem(FS_KEY) || '18', 10);
    if (!FS_SIZES.includes(fs)) fs = 18;
    const applyFs = () => {
      document.documentElement.style.setProperty('--rf-size', fs + 'px');
      (document.getElementById('fsMinus') as HTMLElement | null)?.classList.toggle('on', fs === 16);
      (document.getElementById('fsReset') as HTMLElement | null)?.classList.toggle('on', fs === 18);
      (document.getElementById('fsPlus') as HTMLElement | null)?.classList.toggle('on', fs === 20);
      localStorage.setItem(FS_KEY, String(fs));
    };
    document.getElementById('fsMinus')?.addEventListener('click', () => { fs = Math.max(16, fs - 2); applyFs(); });
    document.getElementById('fsPlus')?.addEventListener('click', () => { fs = Math.min(20, fs + 2); applyFs(); });
    document.getElementById('fsReset')?.addEventListener('click', () => { fs = 18; applyFs(); });
    applyFs();

    // 行距调节
    const LH_VALUES = [1.7, 1.95, 2.2];
    let lhIdx = LH_VALUES.indexOf(parseFloat(localStorage.getItem(LH_KEY) || '1.95'));
    if (lhIdx < 0) lhIdx = 1;
    const applyLh = () => {
      const v = LH_VALUES[lhIdx];
      document.documentElement.style.setProperty('--rf-lh', String(v));
      const b = document.getElementById('lhBtn') as HTMLElement | null;
      if (b) b.textContent = '行距:' + (v === 1.7 ? '紧' : v === 1.95 ? '标' : '宽');
      localStorage.setItem(LH_KEY, String(v));
    };
    document.getElementById('lhBtn')?.addEventListener('click', () => { lhIdx = (lhIdx + 1) % LH_VALUES.length; applyLh(); });
    applyLh();

    // 章节跳转
    const cleanChapter = (ch: string) => ch.replace(/^[&$＄§#*\s]+/, '');
    const nowChapter = document.getElementById('nowChapter') as HTMLElement | null;
    const chapterSelect = document.getElementById('chapterJump') as HTMLSelectElement | null;
    let chapterSeqMap = new Map<string, number>();

    // 书签下拉
    const bmBtn = document.getElementById('bmBtn') as HTMLButtonElement | null;
    const bmList = document.getElementById('bmList') as HTMLElement | null;
    const renderBmList = () => {
      if (!bmList) return;
      if (!bms.length) {
        bmList.innerHTML = '<div class="rf-bm-empty">还没有书签。把鼠标移到段落上，点右上角 ☆ 收藏。</div>';
        return;
      }
      bmList.innerHTML = bms
        .slice()
        .sort((a, b) => a.seq - b.seq)
        .map((b) => `<button class="rf-bm-item" data-seq="${b.seq}"><span class="rf-bm-seq">段${b.seq + 1}</span>${esc(b.chapter)}${b.text ? ' · ' + esc(b.text) : ''}</button>`)
        .join('');
      bmList.querySelectorAll('.rf-bm-item').forEach((el) =>
        el.addEventListener('click', needData(() => {
          bmList.hidden = true;
          gotoStart(parseInt((el as HTMLElement).dataset.seq ?? '', 10));
        }))
      );
    };
    bmBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      bmList!.hidden = !bmList!.hidden;
      renderBmList();
    });
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (bmList && !bmList.hidden && !t.closest('#bmBtn') && !t.closest('#bmList')) bmList.hidden = true;
    });

    // 收藏 / 批注（事件委托；守卫：当前页数据就绪）
    body?.addEventListener('click', (e) => {
      if (!curData) return;
      const t = e.target as HTMLElement;
      const act = t.closest('.rf-act') as HTMLElement | null;
      if (act) {
        const seq = parseInt(act.dataset.seq ?? '', 10);
        if (act.dataset.act === 'bm') {
          const c = curData.chunks.find((x) => x.seq === seq);
          if (!c) return;
          if (bmSet.has(seq)) { bmSet.delete(seq); bms = bms.filter((b) => b.seq !== seq); }
          else { bms.push({ seq, chapter: c.chapter, text: c.text.slice(0, 40), ts: Date.now() }); bmSet.add(seq); }
          saveBms(bms);
          renderCurPage();
        } else if (act.dataset.act === 'note') {
          const cur = noteMap.get(seq)?.note ?? '';
          const val = prompt(cur ? '编辑批注' : '添加批注', cur);
          if (val === null) return;
          notes = notes.filter((n) => n.seq !== seq);
          if (val.trim()) notes.push({ seq, text: '', note: val.trim(), ts: Date.now() });
          noteMap.clear();
          notes.forEach((n) => noteMap.set(n.seq, n));
          saveNotes(notes);
          renderCurPage();
        }
        return;
      }
      const nv = t.closest('.rf-note-view') as HTMLElement | null;
      if (nv) {
        const seq = parseInt(nv.dataset.seq ?? '', 10);
        const cur = noteMap.get(seq)?.note ?? '';
        const val = prompt('编辑批注', cur);
        if (val === null) return;
        notes = notes.filter((n) => n.seq !== seq);
        if (val.trim()) notes.push({ seq, text: '', note: val.trim(), ts: Date.now() });
        noteMap.clear();
        notes.forEach((n) => noteMap.set(n.seq, n));
        saveNotes(notes);
        renderCurPage();
      }
    });

    // 选中文字 → 悬浮工具条（高亮 / 批注）
    const selbar = document.createElement('div');
    selbar.className = 'rf-selbar';
    selbar.innerHTML = '<button data-sel="hl">高亮</button><button data-sel="note">批注</button><button data-sel="off">✕</button>';
    selbar.hidden = true;
    document.body.appendChild(selbar);
    document.addEventListener('mouseup', (e) => {
      if ((e.target as HTMLElement).closest('.rf-selbar')) return;
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || !sel.rangeCount) { selbar.hidden = true; return; }
      const range = sel.getRangeAt(0);
      const anc = range.commonAncestorContainer as Element;
      const item = anc.closest ? anc.closest('.rf-item') : null;
      if (!item || !body || !body.contains(item)) { selbar.hidden = true; return; }
      const text = sel.toString().trim();
      if (!text) { selbar.hidden = true; return; }
      const rect = range.getBoundingClientRect();
      selbar.hidden = false;
      selbar.style.left = Math.max(8, Math.min(window.innerWidth - 150, rect.left + rect.width / 2 - 60)) + 'px';
      selbar.style.top = Math.max(8, rect.top - 44) + 'px';
      selbar.dataset.seq = (item as HTMLElement).dataset.pt ?? '';
      selbar.dataset.text = text;
    });
    document.addEventListener('mousedown', (e) => {
      if ((e.target as HTMLElement).closest('.rf-selbar')) return;
      selbar.hidden = true;
    });
    selbar.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button') as HTMLElement | null;
      if (!b) return;
      const seq = parseInt(selbar.dataset.seq ?? '', 10);
      const text = selbar.dataset.text ?? '';
      if (b.dataset.sel === 'off') {
        selbar.hidden = true;
        window.getSelection()?.removeAllRanges();
        return;
      }
      if (b.dataset.sel === 'hl') {
        if (text) {
          const idx = hls.findIndex((h) => h.seq === seq && h.text === text);
          if (idx >= 0) hls.splice(idx, 1);
          else hls.push({ seq, text, ts: Date.now() });
          saveHls(hls);
          applyHl();
        }
      } else if (b.dataset.sel === 'note') {
        const val = prompt('写批注', '');
        if (val !== null && val.trim()) {
          notes = notes.filter((n) => n.seq !== seq);
          notes.push({ seq, text, note: val.trim(), ts: Date.now() });
          noteMap.clear();
          notes.forEach((n) => noteMap.set(n.seq, n));
          saveNotes(notes);
          renderCurPage();
        }
      }
      selbar.hidden = true;
      window.getSelection()?.removeAllRanges();
    });

    // 分页按钮
    document.getElementById('prevB')?.addEventListener('click', needData(() => goPage(page - 1)));
    document.getElementById('nextB')?.addEventListener('click', needData(() => goPage(page + 1)));

    // 段号跳转
    const jumpInput = document.getElementById('jumpInput') as HTMLInputElement | null;
    const jumpBtn = document.getElementById('jumpBtn') as HTMLButtonElement | null;
    const doJump = () => {
      const p = parseInt(jumpInput?.value || '', 10);
      if (p >= 1 && p <= total) jumpToSeq(p);
    };
    jumpBtn?.addEventListener('click', needData(doJump));
    jumpInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') needData(doJump)();
    });

    // 键盘翻页（排除输入框内按键）
    document.addEventListener('keydown', needData((e) => {
      const tag = (e.target as HTMLElement).tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      if (e.key === 'ArrowLeft') goPage(page - 1);
      if (e.key === 'ArrowRight') goPage(page + 1);
    }));

    // 全文分片索引加载：就绪后填充章节下拉、恢复阅读位置
    fetch('/fulltext/index.json')
      .then((r) => { if (!r.ok) throw new Error('加载失败'); return r.json(); })
      .then((data) => {
        totalPages = Math.max(1, data.pages || 1);
        total = data.total || 0;
        chapterSeqMap = new Map((data.chapters || []).map((c: { name: string; seq: number }) => [c.name, c.seq]));
        dataReadyFlag = true;

        if (chapterSelect) {
          chapterSelect.innerHTML = '<option value="">跳转章节…</option>' + (data.chapters || []).map((c: { name: string; seq: number }) => `<option value="${c.seq}">${esc(cleanChapter(c.name))}</option>`).join('');
          chapterSelect.addEventListener('change', () => {
            const seq = parseInt(chapterSelect.value, 10);
            if (!Number.isNaN(seq)) gotoStart(seq);
          });
        }
        renderBmList();

        // 初始：优先恢复上次阅读位置（静默）；其次 #c 锚点（主动跳转，保留高亮）；否则第 1 页
        const savedPos = loadPos();
        const initHash = location.hash.match(/^#c(\d+)/);
        if (initHash) {
          const seq = parseInt(initHash[1], 10);
          if (!Number.isNaN(seq)) {
            gotoStart(seq, true);
          } else {
            void loadPage(1).then(() => renderCurPage());
          }
        } else if (savedPos >= 0) {
          gotoStart(savedPos, false);
        } else {
          void loadPage(1).then(() => renderCurPage());
        }
      })
      .catch(() => { if (hintEl) hintEl.textContent = '全文数据加载失败'; });
    };
    if ('requestIdleCallback' in window) window.requestIdleCallback(init, { timeout: 1200 });
    else setTimeout(init, 0);
  </script>

