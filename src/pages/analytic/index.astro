---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ArgumentMap from '../../components/ArgumentMap.astro';
import SentenceReader from '../../components/SentenceReader.astro';
import { commentDB } from '../../lib/commentDB';
import { parseSentences } from '../../lib/parse';
import { CHAPTERS } from '../../lib/chapters';
import { DatabaseSync } from 'node:sqlite';
import path from 'node:path';
const title = '先验分析论 · 导读：范畴、演绎与知识如何客观';

interface Item { key: string; ref: string; original: string; deng: string; tip: string }
const pick = (keys: string[]): Item[] => keys
  .map((k) => (commentDB[k] ? { key: k, ...commentDB[k] } : null))
  .filter((x): x is Item => x !== null);
const total = Object.keys(commentDB).filter((k) => k.startsWith('an-')).length;

const ch = CHAPTERS.find((c) => c.key === 'analytic')!;
interface ChunkRow { id: string; seq: number; text: string }
const db = new DatabaseSync(path.join(process.cwd(), 'data/kant.db'));
const raw = db.prepare('SELECT id, seq, text FROM chunks WHERE seq >= ? AND seq <= ? ORDER BY seq').all(ch.lo, ch.hi) as ChunkRow[];
db.close();
const sentences = raw.flatMap((r) => parseSentences(r.text, r.id, r.seq));
---

<Base title={title} current="/analytic/" badge={`导读 · 全部${total}条见句读全库`} searchPlaceholder="搜索：范畴/统觉/图型/因果律…" readingOn>
  <main class="container narrow py-9">
    <PageHead
      chip="Part B · 要素论第二部 · 导读"
      title="先验分析论"
      subtitle="从 12 范畴到牛顿定律先天化 — 这一章回答「知识如何客观有效」"
    />
    <ArgumentMap current="analytic" />

    <!-- 本章任务 -->
    <div class="card mt-5">
      <div class="h3">本章任务 · 它要解决什么问题</div>
      <p class="p text-[13.5px]">感性论给了形式（时空），但只有形式还不够——杂多需要被<b>联结</b>成对象。分析论回答：<b>知性如何用 12 范畴把直观杂多组织成客观知识？</b>核心是证明范畴对一切可能经验有效（先验演绎），并由此推出自然科学的基本原理（如因果律）——正面回击休谟。</p>
      <div class="quote mt-3 text-xs">一句话：范畴是知性为自然立法的形式；没有它们，经验只是一堆碎片，因果律只是心理习惯。</div>
    </div>

    <!-- 论证路线图 -->
    <div class="card mt-5">
      <div class="h3">论证路线图 · 五步</div>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
        <div class="step"><b>① 判断表</b><div>一切思维都是判断：量/质/关系/模态 × 3 = 12 种形式。</div></div>
        <div class="step"><b>② 范畴表</b><div>同一功能：判断中统一表象 → 直观中统一杂多，得 12 范畴。</div></div>
        <div class="step"><b>③ 先验演绎</b><div>"我思"必须伴随一切表象——统觉的统一证明范畴适用于一切经验。</div></div>
        <div class="step"><b>④ 图型法</b><div>范畴是逻辑的、直观是感性的，靠"时间图型"翻译对接。</div></div>
        <div class="step"><b>⑤ 原理体系</b><div>公理/预测/类比/公设——牛顿力学的先天版，回击休谟。</div></div>
      </div>
    </div>

    <!-- 核心句读精选 -->
    <div class="section-head" style="margin:28px 0 12px">
      <div class="h3">核心句读精选 · 读懂本章的关键句</div>
      <span class="font-mono text-[10px] text-muted">完整 {total} 条见 <a href="/deng/" class="underline">句读全库</a></span>
    </div>

    <div class="card mt-3">
      <div class="h3">范畴表 · 判断表→范畴表</div>
      {
        pick(['an-cat-ded-idea', 'an-judg-quantity', 'an-cat-relation-cause', 'an-cat-modality', 'an-cat-table-full']).map((it) => (
          <div class="my-2 readable" data-key={it.key}>
            <div class="font-mono text-[10px] text-muted">{it.ref}</div>
            <div class="serif font-bold my-1">「{it.original}」</div>
            <div class="p text-[13px]">{it.deng}</div>
          </div>
        ))
      }
    </div>

    <div class="card mt-4">
      <div class="h3">先验演绎 · 统觉的最高原理</div>
      {
        pick(['an-ded-b-apper', 'an-ded-b-131', 'an-ded-b-objectivity', 'an-ded-b-limit', 'an-ded-necessity']).map((it) => (
          <div class="my-2 readable" data-key={it.key}>
            <div class="font-mono text-[10px] text-muted">{it.ref}</div>
            <div class="serif font-bold my-1">「{it.original}」</div>
            <div class="p text-[13px]">{it.deng}</div>
          </div>
        ))
      }
    </div>

    <div class="card mt-4">
      <div class="h3">图型法 · 时间图型</div>
      {
        pick(['an-schema-def', 'an-schema-cause', 'an-schema-sub', 'an-schema-time-all']).map((it) => (
          <div class="my-2 readable" data-key={it.key}>
            <div class="font-mono text-[10px] text-muted">{it.ref}</div>
            <div class="serif font-bold my-1">「{it.original}」</div>
            <div class="p text-[13px]">{it.deng}</div>
          </div>
        ))
      }
    </div>

    <div class="card mt-4">
      <div class="h3">原理体系 · 回击休谟的因果律</div>
      {
        pick(['an-prin-anal2', 'an-prin-anal2-proof', 'an-prin-anal2-objective', 'an-prin-anal1', 'an-prin-anal3']).map((it) => (
          <div class="my-2 readable" data-key={it.key}>
            <div class="font-mono text-[10px] text-muted">{it.ref}</div>
            <div class="serif font-bold my-1">「{it.original}」</div>
            <div class="p text-[13px]">{it.deng}</div>
          </div>
        ))
      }
    </div>

    <div class="card mt-4">
      <div class="h3">现象/物自体 · 划界</div>
      {
        pick(['an-phen-noum', 'an-phen-noum-limits', 'an-amphib']).map((it) => (
          <div class="my-2 readable" data-key={it.key}>
            <div class="font-mono text-[10px] text-muted">{it.ref}</div>
            <div class="serif font-bold my-1">「{it.original}」</div>
            <div class="p text-[13px]">{it.deng}</div>
          </div>
        ))
      }
    </div>

    <!-- 逐句助读 · 康德原文 + 邓晓芒讲解 -->
    <div class="section-head" style="margin:28px 0 12px">
      <div class="h3">逐句助读 · {ch.title} · {sentences.length}句</div>
      <span class="font-mono text-[10px] text-muted">一句康德原文，配一段邓晓芒讲解</span>
    </div>
    <SentenceReader sentences={sentences} />

    <!-- 疑难辨析 -->
    <div class="card mt-6" style="background:linear-gradient(180deg,var(--color-card),var(--color-bg2))">
      <div class="h3 accent">常见疑难辨析</div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <b>① "范畴是主观的，知识怎么客观？"</b>
          <p class="p text-[13px] mt-1">客观性不来自对象本身，而来自统觉的<b>必然统一</b>：主观的任意联想（看房子上下扫）与客观的规则相继（船顺流）之所以能区分，正因为范畴提供了必然规则。主观的形式保证了客观的有效。</p>
        </div>
        <div>
          <b>② "康德和休谟到底争什么？"</b>
          <p class="p text-[13px] mt-1">具体因果律（"火使水热"）两人都承认是归纳的；分歧在"一切变化都有原因"这个<b>一般原理</b>——休谟说是习惯，康德说是可能经验的条件。</p>
        </div>
        <div>
          <b>③ "为什么需要两个版本的演绎？"</b>
          <p class="p text-[13px] mt-1">A 版（1781）从三重综合"自下而上"讲，有心理学色彩；B 版（1787）直接从统觉"自上而下"讲，更严格。主流学界认为二者实质一致。</p>
        </div>
        <div>
          <b>④ "图型法是不是多此一举？"</b>
          <p class="p text-[13px] mt-1">范畴是逻辑概念、直观是感性内容，二者异质——就像"圆"的概念与画出的圆。时间图型（数=相继、因果=有规则相继）是必需的"翻译官"。</p>
        </div>
      </div>
    </div>

    <!-- 参考来源 -->
    <div class="card mt-6">
      <div class="h3">参考来源</div>
      <ul class="p text-[12.5px] leading-[1.9] mt-1" style="list-style:none;padding:0">
        <li>· <a href="https://plato.stanford.edu/entries/kant-hume-causality/" target="_blank" rel="noopener" class="underline text-accent">SEP: Kant and Hume on Causality</a></li>
        <li>· <a href="https://plato.stanford.edu/entries/kant-transcendental/" target="_blank" rel="noopener" class="underline text-accent">SEP: Kant's Transcendental Arguments</a></li>
        <li>· 邓晓芒《纯粹理性批判》句读（分析论部分）· 李秋零《康德著作全集》注释本</li>
      </ul>
    </div>

    <div class="flex flex-wrap gap-3 mt-6">
      <a href="/aesthetic/" class="pill">← 感性论</a>
      <a href="/deng/" class="pill">句读全库 全部{total}条 →</a>
      <a href="/dialectic/" class="pill">下一章 辩证论 →</a>
    </div>
  </main>
</Base>
