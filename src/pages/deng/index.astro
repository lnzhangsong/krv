---
import Base from '../../layouts/Base.astro';
import { commentDB } from '../../lib/commentDB';
const title = '邓晓芒句读全库 · 217条完整讲解 | 纯批逐句精读实验室';

const groupDefs: { key: string; title: string }[] = [
  { key: 'pref-', title: '序言' },
  { key: 'intro-', title: '导言' },
  { key: 'ae-', title: '先验感性论' },
  { key: 'an-', title: '先验分析论' },
  { key: 'dia-', title: '先验辩证论' },
  { key: 'meth-', title: '先验方法论' },
];
const groups: { title: string; items: { key: string; ref: string; original: string; deng: string; tip: string }[] }[] = groupDefs.map((gd) => ({
  title: gd.title,
  items: Object.entries(commentDB)
    .filter(([k]) => k.startsWith(gd.key))
    .map(([k, v]) => ({ key: k, ...v })),
})).filter((g) => g.items.length > 0);
const total = Object.keys(commentDB).length;
---

<Base title={title} current="/deng/" badge={`${total}条句读`} searchPlaceholder="全站搜索：二律背反/统觉/存在不是谓词…" readingOn>
  <main class="max-w-[1320px] mx-auto px-7 py-8">
    <div class="chip">DENG XIAOMANG 句读全库 V5 · {total}条 · 按章节分组</div>
    <h1 class="serif text-[38px] leading-tight mt-3.5 mb-2">
      邓晓芒200万字句读<br />
      <span class="text-sm text-muted font-sans tracking-[.18em]">逐句精读实验室 — 点击任意黑体句，右侧滑出详解</span>
    </h1>

    <div class="mt-6">
      {
        groups.map((g) => (
          <div class="mt-7">
            <div class="h3">{g.title} · {g.items.length}条</div>
            <div>
              {
                g.items.map((it) => (
                  <div class="entry readable" data-key={it.key}>
                    <div class="ref mono">{it.ref} · {it.key}</div>
                    <div class="orig">「{it.original}」</div>
                    <div class="p text-[13px] mt-1.5"><b>邓晓芒讲：</b>{it.deng}</div>
                    <div class="mt-1.5"><span class="tag text-[10px]">{it.tip}</span></div>
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </main>

  <style>
    .entry {
      border: 1px solid var(--color-line);
      border-radius: 16px;
      padding: 18px;
      margin: 12px 0;
      background: var(--color-card);
    }
    .entry .ref {
      font-size: 11px;
      color: var(--color-muted);
    }
    .entry .orig {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 16px;
      margin: 8px 0;
    }
  </style>
</Base>
