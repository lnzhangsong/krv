---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import SentenceReader from '../../components/SentenceReader.astro';
import { commentDB } from '../../lib/commentDB';
import { parseSentences } from '../../lib/parse';
import { CHAPTERS } from '../../lib/chapters';
import { DatabaseSync } from 'node:sqlite';
import path from 'node:path';
const title = '邓晓芒句读全库 · 217条精选 + 逐句讲解 | 纯批逐句精读实验室';

const groupDefs: { key: string; title: string }[] = [
  { key: 'pref-', title: '序言' },
  { key: 'intro-', title: '导言' },
  { key: 'ae-', title: '先验感性论' },
  { key: 'an-', title: '先验分析论' },
  { key: 'dia-', title: '先验辩证论' },
  { key: 'meth-', title: '先验方法论' },
];
const groups: { title: string; items: { key: string; ref: string; original: string; deng: string; tip: string }[] }[] = groupDefs.map((gd) => ({
  title: gd.title,
  items: Object.entries(commentDB)
    .filter(([k]) => k.startsWith(gd.key))
    .map(([k, v]) => ({ key: k, ...v })),
})).filter((g) => g.items.length > 0);
const total = Object.keys(commentDB).length;

interface ChunkRow { id: string; seq: number; text: string }
const db = new DatabaseSync(path.join(process.cwd(), 'data/kant.db'));
const allRaw = db.prepare('SELECT id, seq, text FROM chunks').all() as ChunkRow[];
db.close();
const chapterSentences = CHAPTERS.map((ch) => ({
  ...ch,
  sentences: allRaw
    .filter((r) => r.seq >= ch.lo && r.seq <= ch.hi)
    .flatMap((r) => parseSentences(r.text, r.id, r.seq)),
}));
const sentenceTotal = chapterSentences.reduce((s, c) => s + c.sentences.length, 0);
---

<Base title={title} current="/deng/" badge={`${total}条精选 + ${sentenceTotal}句逐句`} searchPlaceholder="全站搜索：二律背反/统觉/存在不是谓词…" readingOn>
  <main class="container narrow py-8">
    <PageHead
      chip={`DENG XIAOMANG · 句读全库 · ${total}条精选 + ${sentenceTotal}句逐句讲解`}
      title="邓晓芒句读 · 逐句讲解"
      subtitle="一句康德原文，配一段邓晓芒讲解；完整原文见「全文直读」。"
    />

    {
      chapterSentences.map((ch) => (
        <div class="mt-8">
          <div class="section-head">
            <div class="h3">{ch.title} · 逐句讲解 {ch.sentences.length}句</div>
            <a href={`/${ch.key}/`} class="font-mono text-[10px] text-accent2 underline">该章导读页 →</a>
          </div>
          <SentenceReader sentences={ch.sentences} pageSize={12} floating={false} />
        </div>
      ))
    }

    <div class="mt-8">
      <div class="section-head">
        <div class="h3">手工精选 · {total}条 · 点击右侧滑出详解</div>
      </div>
      <div>
        {
          groups.map((g) => (
            <div class="mt-7">
              <div class="h3">{g.title} · {g.items.length}条</div>
              <div>
                {
                  g.items.map((it) => (
                    <div class="entry readable" data-key={it.key}>
                      <div class="ref mono">{it.ref} · {it.key}</div>
                      <div class="orig">「{it.original}」</div>
                      <div class="p text-[13px] mt-1.5"><b>邓晓芒讲：</b>{it.deng}</div>
                      <div class="mt-1.5"><span class="tag text-[10px]">{it.tip}</span></div>
                    </div>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>

  <style>
    .entry {
      border: 1px solid var(--color-line);
      border-radius: 16px;
      padding: 18px;
      margin: 12px 0;
      background: var(--color-card);
      transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
    }
    .entry:hover {
      border-color: color-mix(in srgb, var(--color-accent2) 40%, var(--color-line));
      box-shadow: var(--shadow-soft);
      transform: translateY(-1px);
    }
    .entry .ref {
      font-size: 11px;
      color: var(--color-muted);
    }
    .entry .orig {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 16px;
      margin: 8px 0;
    }
  </style>
</Base>
