---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { commentDB } from '../../lib/commentDB';
const title = '邓晓芒句读全库 · 217条精选 | 纯批精读库';

const groupDefs: { key: string; title: string }[] = [
  { key: 'pref-', title: '序言' },
  { key: 'intro-', title: '导言' },
  { key: 'ae-', title: '先验感性论' },
  { key: 'an-', title: '先验分析论' },
  { key: 'dia-', title: '先验辩证论' },
  { key: 'meth-', title: '先验方法论' },
];
const groups: { title: string; items: { key: string; ref: string; original: string; deng: string; tip: string }[] }[] = groupDefs.map((gd) => ({
  title: gd.title,
  items: Object.entries(commentDB)
    .filter(([k]) => k.startsWith(gd.key))
    .map(([k, v]) => ({ key: k, ...v })),
})).filter((g) => g.items.length > 0);
const total = Object.keys(commentDB).length;
---

<Base title={title} current="/deng/" badge={`${total}条精选`} searchPlaceholder="全站搜索：二律背反/统觉/存在不是谓词…">
  <main class="container narrow py-8">
    <PageHead
      chip={`DENG XIAOMANG · 句读全库 · ${total}条精选`}
      title="邓晓芒句读 · 精选"
      subtitle="按序言、导言与四大部归档的精选句读：原文位置、邓晓芒讲解与学习提示；完整原文见「全文直读」。"
    />

    <div class="mt-8">
      <div class="section-head">
        <div class="h3">手工精选 · {total}条</div>
      </div>
      <div>
        {
          groups.map((g) => (
            <div class="mt-7">
              <div class="h3">{g.title} · {g.items.length}条</div>
              <div>
                {
                  g.items.map((it) => (
                    <div class="entry">
                      <div class="ref mono">{it.ref} · {it.key}</div>
                      <div class="orig">「{it.original}」</div>
                      <div class="p text-[13px] mt-1.5"><b>邓晓芒讲：</b>{it.deng}</div>
                      <div class="mt-1.5"><span class="tag text-[10px]">{it.tip}</span></div>
                    </div>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>

  <style>
    .entry {
      border: 1px solid var(--color-line);
      border-radius: 16px;
      padding: 18px;
      margin: 12px 0;
      background: var(--color-card);
      transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
    }
    .entry:hover {
      border-color: color-mix(in srgb, var(--color-accent2) 40%, var(--color-line));
      box-shadow: var(--shadow-soft);
      transform: translateY(-1px);
    }
    .entry .ref {
      font-size: 11px;
      color: var(--color-muted);
    }
    .entry .orig {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 16px;
      margin: 8px 0;
    }
  </style>
</Base>
