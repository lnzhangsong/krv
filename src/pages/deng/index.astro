---
import Base from '../../layouts/Base.astro';
import { commentDB } from '../../lib/commentDB';
const title = '邓晓芒句读全库 116条 · 纯批逐句精读实验室';

const groups = new Map<string, { key: string; ref: string; original: string; deng: string; tip: string }[]>();
for (const [key, v] of Object.entries(commentDB)) {
  const chap = v.ref.split(' ')[0];
  const list = groups.get(chap) ?? [];
  list.push({ key, ...v });
  groups.set(chap, list);
}
const order = ['A版序言', 'B版序言', '导言', 'A23/', 'A30/', 'A54/', 'A66/', 'A93/', 'A99', 'A124', 'B129', 'B141', 'A137', 'A161', 'A182', 'A211', 'A235', 'A260', 'A307', 'A293', 'A348', 'A405', 'A426', 'A431', 'A444', 'A452', 'A567', 'A592', 'A603', 'A620', 'A644', 'A712', 'A795', 'A832', 'A852'];
const sorted = [...groups.keys()].sort((a, b) => {
  const ia = order.findIndex((o) => a.startsWith(o));
  const ib = order.findIndex((o) => b.startsWith(o));
  return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
});
const total = Object.keys(commentDB).length;
---

<Base title={title} current="/deng/" badge="116条句读" searchPlaceholder="全站搜索：二律背反/统觉/存在不是谓词…" readingOn>
  <main class="max-w-[1320px] mx-auto px-7 py-8">
    <div class="chip">DENG XIAOMANG 句读全库 V5 · {total}条 · 按原书14讲重排</div>
    <h1 class="serif text-[38px] leading-tight mt-3.5 mb-2">
      邓晓芒200万字句读<br />
      <span class="text-sm text-muted font-sans tracking-[.18em]">逐句精读实验室 — 点击任意黑体句，右侧滑出详解</span>
    </h1>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="card bg-bg2">
        <b class="font-mono">使用说明</b>
        <p class="p text-[13px]">本页不是盗版句读原文，而是根据邓晓芒讲演录、sina博客句读、商务14讲、Philopedia/SEP思想脉络，按<b>同情的理解</b>原则提炼的“邓氏讲法”。每条都含：原文定位 + 邓氏口吻解读 + 学习提示。已开启精读模式，直接点击。</p>
      </div>
      <div class="card">
        <div class="h3">统计</div>
        <div class="grid grid-cols-3 gap-4">
          <div><b class="text-[22px]">{total}+</b><div class="font-mono text-[11px]">句读条目</div></div>
          <div><b class="text-[22px]">14</b><div class="font-mono text-[11px]">讲全覆盖</div></div>
          <div><b class="text-[22px]">lunr</b><div class="font-mono text-[11px]">全站搜索</div></div>
        </div>
      </div>
    </div>

    <div class="mt-6">
      {
        sorted.map((chap) => {
          const items = groups.get(chap)!;
          return (
            <div class="mt-7">
              <div class="h3">{chap}</div>
              <div>
                {
                  items.map((it) => (
                    <div class="entry readable" data-key={it.key}>
                      <div class="ref mono">{it.ref} · {it.key}</div>
                      <div class="orig">「{it.original}」</div>
                      <div class="p text-[13px] mt-1.5"><b>邓晓芒讲：</b>{it.deng}</div>
                      <div class="mt-1.5"><span class="tag text-[10px]">{it.tip}</span></div>
                    </div>
                  ))
                }
              </div>
            </div>
          );
        })
      }
    </div>
  </main>

  <style>
    .entry {
      border: 1px solid var(--color-line);
      border-radius: 16px;
      padding: 18px;
      margin: 12px 0;
      background: var(--color-card);
    }
    .entry .ref {
      font-size: 11px;
      color: var(--color-muted);
    }
    .entry .orig {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 16px;
      margin: 8px 0;
    }
  </style>
</Base>
