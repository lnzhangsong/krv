---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { ROOT, ARG_BRANCHES, MAIN_LINE } from '../../lib/knowledge';
import { commentDB } from '../../lib/commentDB';
const title = '知识结构网 · 全书论证树 | 纯批导读';
const nodeCount = ARG_BRANCHES.reduce((s, b) => s + b.steps.reduce((n, st) => n + st.nodes.length, 0), 0);

// 收集所有概念挂接的句读条目，仅内嵌被引用的部分
const refKeys = Array.from(new Set(ARG_BRANCHES.flatMap((b) => b.steps.flatMap((s) => s.nodes.flatMap((n) => n.refs ?? [])))));
const refsData: Record<string, { ref: string; original: string; deng: string }> = {};
for (const k of refKeys) {
  const e = commentDB[k];
  if (e) refsData[k] = { ref: e.ref, original: e.original, deng: e.deng };
}
const refsJson = JSON.stringify(refsData).replace(/</g, '\\u003c');
---

<Base title={title} current="/map/" badge="全书论证树" searchPlaceholder="全站搜索：统觉/范畴/二律背反…">
  <main class="container py-8">
    <PageHead
      chip="ARGUMENT TREE · 全书论证树 · 4部 · { nodeCount }个概念节点"
      title="知识结构网 · 全书论证树"
      subtitle="按「总问题 → 四大部 → 各步论证 → 概念」纵向展开，箭头标注每步的论证关系；悬停或点按概念框即可查看定义与同类对照。"
    />

    <section class="card root-card">
      <div class="root-label">全书总问题</div>
      <div class="root-q">{ROOT.label}</div>
      <p class="root-def">{ROOT.def}</p>
      <div class="root-flow">
        {
          ARG_BRANCHES.map((b) => (
            <a class="root-flow-item" href={`#${b.key}`}>
              <span class="inline-block w-2.5 h-2.5 rounded-full mr-1.5" style={`background:${b.color}`}></span>
              {b.title}
            </a>
          ))
        }
      </div>
    </section>

    <section class="mainline">
      {
        MAIN_LINE.map((m, i) => (
          <div class="mainline-item">
            <span class="mainline-seq">{i + 1}</span>
            <span>{m}</span>
          </div>
        ))
      }
    </section>

    <div class="tree">
      {
        ARG_BRANCHES.map((b) => (
          <section class="branch" id={b.key}>
            <div class="branch-head" style={`border-color:${b.color}`}>
              <div>
                <div class="branch-title">{b.title}</div>
                <div class="branch-question">这一部要回答：{b.question}</div>
              </div>
              <span class="branch-count">{b.steps.reduce((n, st) => n + st.nodes.length, 0)} 概念</span>
            </div>

            <div class="steps">
              {
                b.steps.map((st) => (
                  <div class="step">
                    {st.rel && (
                      <div class="step-rel">
                        <span class="step-rel-line"></span>
                        <span class="step-rel-label">↓ {st.rel}</span>
                      </div>
                    )}
                    <div class="step-nodes">
                      {
                        st.nodes.map((n) => (
                          <button
                            class={`anode ${n.k ? 'term' : ''}`}
                            type="button"
                            data-k={n.k}
                            data-def={n.def}
                            data-label={n.label}
                            data-refs={n.refs?.join(',')}
                          >
                            <b>{n.label}</b>
                            {n.note && <span class="anode-note">{n.note}</span>}
                          </button>
                        ))
                      }
                    </div>
                  </div>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
  </main>

  <div class="tree-panel" id="treePanel" hidden>
    <div class="flex items-center justify-between gap-2 mb-2">
      <b class="tree-panel-title" id="tpLabel">概念</b>
      <button id="tpClose" class="toggle">✕</button>
    </div>
    <div id="tpGroup" class="tree-panel-group"></div>
    <p class="p text-[13px] leading-[1.9] mt-2" id="tpDef"></p>
    <div id="tpSame" class="tree-panel-same"></div>
    <div id="tpRefs" class="tree-panel-refs"></div>
    <a id="tpGlossary" class="btn link mt-3" href="/glossary/">术语库查看 →</a>
  </div>
</Base>

<script is:inline type="application/json" id="refs-data" set:html={refsJson}></script>

<script>
  const termDataEl = document.getElementById('term-data') as HTMLScriptElement | null;
  const terms: { k: string; b: string; d: string; x?: string; g: string }[] = termDataEl ? JSON.parse(termDataEl.textContent || '[]') : [];
  const byKey = new Map(terms.map((t) => [t.k, t]));
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  const panel = document.getElementById('treePanel') as HTMLElement | null;
  const tpLabel = document.getElementById('tpLabel') as HTMLElement | null;
  const tpGroup = document.getElementById('tpGroup') as HTMLElement | null;
  const tpDef = document.getElementById('tpDef') as HTMLElement | null;
  const tpSame = document.getElementById('tpSame') as HTMLElement | null;
  const tpRefs = document.getElementById('tpRefs') as HTMLElement | null;

  const refsDataEl = document.getElementById('refs-data') as HTMLScriptElement | null;
  const refsData: Record<string, { ref: string; original: string; deng: string }> = refsDataEl ? JSON.parse(refsDataEl.textContent || '{}') : {};

  const renderRefs = (keys: string[]) => {
    if (!tpRefs) return;
    const items = keys.map((k) => {
      const e = refsData[k];
      if (!e) return '';
      const deng = e.deng.length > 120 ? e.deng.slice(0, 120) + '…' : e.deng;
      return `<div class="ref-item">
        <div class="ref-item-ref">${esc(e.ref)}</div>
        <div class="ref-item-orig">「${esc(e.original)}」</div>
        <div class="ref-item-deng">邓晓芒讲：${esc(deng)}</div>
        <a class="ref-item-link" href="/quotes/#${k}">完整讲解 →</a>
      </div>`;
    }).join('');
    tpRefs.innerHTML = items
      ? `<div class="h3 mt-4">相关句读 · 论证详解</div>${items}`
      : '';
  };

  const showPanel = (el: HTMLElement) => {
    if (!panel || !tpLabel || !tpDef || !tpGroup || !tpSame) return;
    const k = el.dataset.k;
    const term = k ? byKey.get(k) : undefined;
    const label = el.dataset.label ?? '';
    const def = term?.d ?? el.dataset.def ?? '（暂无释义）';
    tpLabel.textContent = label;
    tpGroup.innerHTML = term ? `<span class="chip" style="border-color:var(--color-accent2);color:var(--color-accent2)">${esc(term.g)}</span>` : '';
    tpDef.textContent = def;
    if (term) {
      const same = terms.filter((t) => t.g === term.g && t.k !== term.k);
      const sameShown = same.slice(0, 12);
      tpSame.innerHTML = sameShown.length
        ? `<div class="h3 mt-3">同类对照</div><div class="flex flex-wrap gap-2 mt-1">${sameShown
            .map((s) => `<button class="term-chip" data-k="${s.k}">${esc(s.b)}</button>`)
            .join('')}</div>`
        : '';
      tpSame.querySelectorAll('.term-chip').forEach((ch) =>
        ch.addEventListener('click', () => {
          const t = byKey.get((ch as HTMLElement).dataset.k ?? '');
          if (t) {
            tpLabel.textContent = t.b;
            tpGroup.innerHTML = `<span class="chip" style="border-color:var(--color-accent2);color:var(--color-accent2)">${esc(t.g)}</span>`;
            tpDef.textContent = t.d;
            renderRefs([]);
          }
        })
      );
    } else {
      tpSame.innerHTML = '';
    }
    renderRefs((el.dataset.refs ?? '').split(',').filter(Boolean));
    panel.hidden = false;
  };

  document.querySelectorAll('.anode').forEach((el) => {
    el.addEventListener('click', () => showPanel(el as HTMLElement));
  });
  document.getElementById('tpClose')?.addEventListener('click', () => {
    if (panel) panel.hidden = true;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.hidden) panel.hidden = true;
  });
  document.addEventListener('click', (e) => {
    if (panel && !panel.hidden && !(e.target as HTMLElement).closest('#treePanel') && !(e.target as HTMLElement).closest('.anode')) {
      panel.hidden = true;
    }
  });
</script>

  <style is:global>
    /* ===== 根节点卡片 ===== */
  .root-card {
    position: relative;
    border-left: 4px solid var(--color-accent2);
    background: linear-gradient(180deg, var(--color-card), var(--color-bg2));
    padding: 20px 24px;
  }
  .root-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--color-accent2);
    text-transform: uppercase;
  }
  .root-q {
    font-family: var(--font-serif);
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 900;
    margin-top: 6px;
  }
  .root-def {
    margin-top: 6px;
    color: color-mix(in srgb, var(--color-ink) 75%, var(--color-muted));
    max-width: 64ch;
  }
  .root-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .root-flow-item {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 4px 12px;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .root-flow-item:hover {
    border-color: color-mix(in srgb, var(--color-accent2) 55%, var(--color-line));
    color: var(--color-ink);
    background: var(--color-card);
  }

  /* ===== 论证主线 ===== */
  .mainline {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  .mainline-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--color-line);
    background: var(--color-card);
    border-radius: 999px;
    padding: 6px 14px 6px 8px;
    font-size: 12.5px;
    color: color-mix(in srgb, var(--color-ink) 78%, var(--color-muted));
  }
  .mainline-seq {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    flex-shrink: 0;
  }

  /* ===== 分支（四大部） ===== */
  .tree {
    margin-top: 26px;
  }
  .branch {
    margin-top: 28px;
  }
  .branch-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    border-left: 5px solid;
    background: var(--color-card);
    border-radius: 0 14px 14px 0;
    padding: 12px 18px;
    box-shadow: var(--shadow-soft);
  }
  .branch-title {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 800;
  }
  .branch-question {
    font-size: 12.5px;
    color: var(--color-muted);
    margin-top: 2px;
  }
  .branch-count {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 2px 10px;
  }

  /* ===== 步骤流 ===== */
  .steps {
    padding: 4px 0 4px 26px;
  }
  .step {
    margin-top: 6px;
  }
  .step-rel {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 4px 0 4px;
  }
  .step-rel-line {
    flex: none;
    width: 0;
    height: 16px;
    border-left: 2px dashed color-mix(in srgb, var(--color-accent2) 55%, var(--color-line));
    margin-left: 8px;
  }
  .step-rel-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-accent2);
    background: color-mix(in srgb, var(--color-accent2) 10%, transparent);
    border-radius: 6px;
    padding: 2px 8px;
  }
  .step-nodes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .anode {
    flex: 1 1 200px;
    max-width: 300px;
    text-align: left;
    border: 1px solid var(--color-line);
    background: var(--color-card);
    border-radius: 12px;
    padding: 10px 14px;
    cursor: pointer;
    font: inherit;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .anode b {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--color-accent);
    display: block;
  }
  .anode-note {
    display: block;
    font-size: 12px;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-ink) 72%, var(--color-muted));
    margin-top: 4px;
  }
  .anode:hover {
    border-color: color-mix(in srgb, var(--color-accent2) 55%, var(--color-line));
    box-shadow: var(--shadow-soft);
    transform: translateY(-1px);
  }
  .anode.term {
    border-bottom-style: solid;
  }
  .anode.term:hover {
    background: color-mix(in srgb, var(--color-accent2) 8%, var(--color-card));
  }

  /* ===== 定义面板 ===== */
  .tree-panel {
    position: fixed;
    right: 18px;
    bottom: 18px;
    width: min(360px, 92vw);
    max-height: 62vh;
    overflow: auto;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: 16px;
    box-shadow: var(--shadow-pop);
    padding: 18px;
    z-index: 200;
  }
  .tree-panel[hidden] {
    display: none;
  }
  .tree-panel-title {
    font-family: var(--font-serif);
    font-size: 18px;
  }
  .tree-panel-same .term-chip {
    border: 1px solid var(--color-line);
    background: var(--color-bg2);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 11.5px;
    color: var(--color-accent);
    cursor: pointer;
  }
  .tree-panel-same .term-chip:hover {
    border-color: color-mix(in srgb, var(--color-accent2) 55%, var(--color-line));
  }
  .tree-panel-refs .ref-item {
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-accent2);
    border-radius: 0 10px 10px 0;
    background: var(--color-bg2);
    padding: 10px 12px;
    margin-top: 10px;
  }
  .ref-item-ref {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-accent2);
    letter-spacing: 0.04em;
  }
  .ref-item-orig {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 13.5px;
    color: var(--color-accent);
    margin-top: 5px;
    line-height: 1.6;
  }
  .ref-item-deng {
    font-size: 12px;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-ink) 76%, #6b4a12);
    margin-top: 5px;
  }
  .ref-item-link {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-muted);
  }
  .ref-item-link:hover {
    color: var(--color-accent2);
  }

  @media (max-width: 640px) {
    .steps {
      padding-left: 10px;
    }
    .anode {
      flex-basis: 100%;
      max-width: none;
    }
  }
</style>
