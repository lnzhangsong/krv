---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { commentDB } from '../../lib/commentDB';
import { wrapTerms } from '../../lib/glossary';
import { DatabaseSync } from 'node:sqlite';
import path from 'node:path';
const title = '邓晓芒句读全库 · 217条精选 | 纯批精读库';

const groupDefs: { key: string; title: string }[] = [
  { key: 'pref-', title: '序言' },
  { key: 'intro-', title: '导言' },
  { key: 'ae-', title: '先验感性论' },
  { key: 'an-', title: '先验分析论' },
  { key: 'dia-', title: '先验辩证论' },
  { key: 'meth-', title: '先验方法论' },
];
const groups: { title: string; items: { key: string; ref: string; original: string; deng: string; tip: string }[] }[] = groupDefs.map((gd) => ({
  title: gd.title,
  items: Object.entries(commentDB)
    .filter(([k]) => k.startsWith(gd.key))
    .map(([k, v]) => ({ key: k, ...v })),
})).filter((g) => g.items.length > 0);
const total = Object.keys(commentDB).length;

// 构建期把每条句读的康德原文定位到全文段号，用于「定位原文 →」跳转（仅当原文逐字出现在全文中）
const db = new DatabaseSync(path.join(process.cwd(), 'data/kant.db'));
const chunkRows = db.prepare('SELECT seq, text FROM chunks').all() as { seq: number; text: string }[];
db.close();
const cleanT = (t: string) => t.replace(/\s+/g, '');
const cleanP = (t: string) => t.replace(/[，。、；：？！“”‘’（）·—…《》「」【】,.?!;:()'"·\s]/g, '');
const cleanedChunks = chunkRows.map((r) => ({ seq: r.seq, text: cleanT(r.text) }));
const seqByKey: Record<string, number> = {};
for (const [key, e] of Object.entries(commentDB)) {
  const ws = cleanT(e.original);
  const ps = cleanP(e.original);
  let found = -1;
  for (const r of cleanedChunks) {
    if (ws && r.text.includes(ws)) { found = r.seq; break; }
  }
  if (found === -1 && ps) {
    for (const r of cleanedChunks) {
      if (r.text.includes(ps)) { found = r.seq; break; }
    }
  }
  if (found === -1) {
    for (let i = 0; i + 8 <= ps.length; i++) {
      const run = ps.slice(i, i + 8);
      const hit = cleanedChunks.find((r) => r.text.includes(run));
      if (hit) { found = hit.seq; break; }
    }
  }
  if (found >= 0) seqByKey[key] = found;
}
// 章节条目 → 章节导读页（用于「章节导读 →」链接）
const chapterRoute: Record<string, string> = {
  ae: '/aesthetic/',
  an: '/analytic/',
  dia: '/dialectic/',
  meth: '/method/',
};
const chapOf = (key: string) => chapterRoute[key.split('-')[0]];
---

<Base title={title} current="/quotes/" badge={`${total}条精选`} searchPlaceholder="全站搜索：二律背反/统觉/存在不是谓词…">
  <main class="container narrow py-8">
    <PageHead
      chip={`DENG XIAOMANG · 句读全库 · ${total}条精选`}
      title="邓晓芒句读 · 精选"
      subtitle="按序言、导言与四大部归档的精选句读：原文位置、邓晓芒讲解与学习提示；完整原文见「全文直读」。"
    />

    <div class="mt-8">
      <div class="section-head">
        <div class="h3">手工精选 · {total}条</div>
      </div>
      <div>
        {
          groups.map((g) => (
            <div class="mt-7">
              <div class="h3">{g.title} · {g.items.length}条</div>
              <div>
                {
                  g.items.map((it) => (
                    <div class="entry" id={it.key}>
                      <div class="ref mono">{it.ref} · {it.key}</div>
                      <div class="orig" set:html={`「${wrapTerms(it.original)}」`}></div>
                      <div class="p text-[13px] mt-1.5"><b>邓晓芒讲：</b><span set:html={wrapTerms(it.deng)}></span></div>
                      <div class="mt-1.5"><span class="tag text-[10px]">{it.tip}</span></div>
                      <div class="mt-2 flex flex-wrap gap-1.5 items-center">
                        {seqByKey[it.key] !== undefined && (
                          <a class="tag hover:text-ink" href={`/reading/#c${seqByKey[it.key]}`}>定位原文 →</a>
                        )}
                        {chapOf(it.key) && (
                          <a class="tag hover:text-ink" href={chapOf(it.key)}>章节导读 →</a>
                        )}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>

  <style>
    .entry {
      border: 1px solid var(--color-line);
      border-radius: 16px;
      padding: 18px;
      margin: 12px 0;
      background: var(--color-card);
      transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
      scroll-margin-top: 84px;
    }
    .entry:hover {
      border-color: color-mix(in srgb, var(--color-accent2) 40%, var(--color-line));
      box-shadow: var(--shadow-soft);
      transform: translateY(-1px);
    }
    .entry .ref {
      font-size: 11px;
      color: var(--color-muted);
    }
    .entry .orig {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 16px;
      margin: 8px 0;
    }
  </style>
</Base>
