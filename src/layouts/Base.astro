---
interface Props {
  title: string;
  desc?: string;
  searchPlaceholder?: string;
  readingOn?: boolean;
  current?: string;
  badge?: string;
}
const {
  title,
  desc,
  searchPlaceholder = '全站搜索：存在不是谓词 / 二律背反 / 统觉…',
  readingOn = false,
  current = '/',
  badge,
} = Astro.props;

const navMain: { href: string; label: string }[] = [
  { href: '/aesthetic/', label: '感性论' },
  { href: '/analytic/', label: '分析论' },
  { href: '/dialectic/', label: '辩证论' },
  { href: '/method/', label: '方法论' },
  { href: '/deng/', label: '句读全库' },
  { href: '/glossary/', label: '术语库' },
];
const navMore: { href: string; label: string; desc: string }[] = [
  { href: '/quanwen/', label: '全文直读', desc: '2381页全文' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {desc && <meta name="description" content={desc} />}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700;900&family=Inter:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body class={readingOn ? 'reading-on' : ''}>
    <header class="sticky top-0 z-[100] backdrop-blur-[20px] saturate-[180%] border-b border-line">
      <div class="max-w-[1320px] mx-auto px-7 h-[68px] flex items-center justify-between gap-4">
        <div class="flex items-center gap-2.5 shrink-0">
          <a href="/" class="flex items-center gap-2 group">
            <span class="logo-dot" aria-hidden="true"></span>
            <span class="font-mono font-extrabold tracking-tight text-[15px] group-hover:text-accent2 transition-colors">KRV V5</span>
          </a>
          <span class="badge hidden md:inline-block">{badge ?? '217句读 · Astro + Tailwind'}</span>
        </div>
        <div class="flex items-center gap-2 min-w-0">
          <div id="searchWrap" class="relative shrink min-w-0">
            <span class="search-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </span>
            <input
              id="globalSearch"
              placeholder={searchPlaceholder}
              class="border border-line rounded-full pl-8 pr-4 py-2 w-[200px] md:w-[240px] xl:w-[280px] bg-card font-mono text-sm outline-none transition-all focus:border-accent2 focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent2)_25%,transparent)]"
            />
            <div id="searchResults" class="hidden absolute top-[42px] left-0 right-0 bg-card border border-line rounded-xl shadow-[var(--shadow-pop)] max-h-[420px] overflow-auto z-50 text-left"></div>
          </div>
          <nav class="hidden lg:flex items-center gap-1 font-mono text-[11px] text-muted">
            {navMain.map((n) => (
              <a href={n.href} class={`navlink ${current === n.href ? 'text-ink font-bold bg-bg2' : 'hover:text-ink hover:bg-bg2'}`} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a>
            ))}
            <div id="moreMenu" class="relative">
              <button id="moreBtn" class="navlink hover:bg-bg2" aria-haspopup="true" aria-expanded="false">更多 ▾</button>
              <div id="morePanel" class="hidden absolute right-0 top-full pt-2 z-50">
                <div class="w-[220px] bg-card border border-line rounded-xl shadow-[var(--shadow-soft)] overflow-hidden">
                  {navMore.map((m) => (
                    <a href={m.href} class="block px-4 py-2.5 hover:bg-bg2 border-b border-line last:border-0">
                      <div class="font-bold text-[11px]">{m.label}</div>
                      <div class="text-[10px] text-muted">{m.desc}</div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </nav>
          <button id="toggleReading" class="toggle hidden sm:inline-flex">○ 精读</button>
          <button id="navToggle" class="lg:hidden hamburger" aria-label="打开菜单" aria-expanded="false">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <nav id="mobileNav" class="mobile-nav" aria-label="移动端导航">
      {navMain.concat(navMore.map((m) => ({ href: m.href, label: m.label }))).map((n) => (
        <a href={n.href} class={current === n.href ? 'active' : ''}>{n.label}</a>
      ))}
    </nav>

    <slot />

    <footer class="max-w-[1320px] mx-auto px-7 py-12 flex flex-wrap justify-between gap-3 text-sm text-muted border-t border-line mt-14">
      <div>
        <div class="font-mono font-extrabold tracking-tight text-ink mb-1.5">KRV V5</div>
        <span>康德《纯粹理性批判》导读站 · 仅学习交流</span>
      </div>
      <div class="text-right">
        <div class="font-mono text-xs">commentDB 217条 · 离线全文 2381页</div>
        <div class="font-mono text-[11px] mt-1">Astro + Tailwind v4 · 数据本地内置</div>
      </div>
    </footer>

    <div id="drawer" class="flex flex-col">
      <div id="closeDrawer" class="close">✕</div>
      <div class="chip self-start">逐句精读</div>
      <div id="drawerRef" class="font-mono text-[11px] text-muted mt-3"></div>
      <div id="drawerOrig" class="serif text-[17px] font-bold my-3.5 leading-relaxed"></div>
      <div class="bg-bg2 rounded-xl p-3.5">
        <div class="h3">邓晓芒式句读</div>
        <div id="drawerDeng" class="p text-sm"></div>
      </div>
      <div class="mt-3 bg-[color-mix(in_srgb,var(--color-accent2)_12%,transparent)] rounded-xl p-3.5">
        <div class="h3">学习提示</div>
        <div id="drawerTip" class="p text-[13px]"></div>
      </div>
    </div>

    <script>
      import '../lib/globalSearch';
      import { initReader } from '../lib/reader';
      initReader();

      // 移动端导航
      const navToggle = document.getElementById('navToggle') as HTMLButtonElement;
      const mobileNav = document.getElementById('mobileNav') as HTMLElement;
      navToggle?.addEventListener('click', () => {
        const open = mobileNav.classList.toggle('open');
        navToggle.classList.toggle('open', open);
        navToggle.setAttribute('aria-expanded', String(open));
      });
      mobileNav?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'A') {
          mobileNav.classList.remove('open');
          navToggle?.classList.remove('open');
          navToggle?.setAttribute('aria-expanded', 'false');
        }
      });

      // 更多下拉
      const moreBtn = document.getElementById('moreBtn') as HTMLButtonElement;
      const morePanel = document.getElementById('morePanel') as HTMLElement;
      moreBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = morePanel.classList.toggle('hidden');
        moreBtn.setAttribute('aria-expanded', String(!open));
      });
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (morePanel && !morePanel.classList.contains('hidden') && !t.closest('#moreMenu')) {
          morePanel.classList.add('hidden');
          moreBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>
