---
import { TERMS_JSON } from '../lib/glossary';
interface Props {
  title: string;
  desc?: string;
  searchPlaceholder?: string;
  current?: string;
  badge?: string;
}
const {
  title,
  desc,
  searchPlaceholder = '全站搜索：存在不是谓词 / 二律背反 / 统觉…',
  current = '/',
  badge,
} = Astro.props;

const navMain: { href: string; label: string }[] = [
  { href: '/reading/', label: '全文直读' },
  { href: '/aesthetic/', label: '感性论' },
  { href: '/analytic/', label: '分析论' },
  { href: '/dialectic/', label: '辩证论' },
  { href: '/method/', label: '方法论' },
  { href: '/quotes/', label: '句读全库' },
  { href: '/glossary/', label: '术语库' },
];
const navMore: { href: string; label: string; desc: string }[] = [
  { href: '/map/', label: '知识结构网', desc: '全书论证树' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script is:inline>
      // 首帧渲染前恢复主题，避免暗色模式下先闪浅色再变黑（FOUC）
      (function () {
        var t = null;
        try { var v = localStorage.getItem('krv-theme'); if (v === 'dark' || v === 'light') t = v; } catch (e) { /* ignore */ }
        if (!t) t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        // 仅 macOS 标记 .mac：Windows/Linux 不启用 antialiased，避免关闭 ClearType 后小字号发虚
        if (navigator.platform === 'MacIntel') document.documentElement.classList.add('mac');
      })();
    </script>
    <title>{title}</title>
    {desc && <meta name="description" content={desc} />}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700;900&family=Inter:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <!-- 只加载正文实际使用的 regular/bold 两个字重，省掉 light/mono 变体的请求与解析 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/lxgwwenkai-regular.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/lxgwwenkai-bold.css" />
    <style is:global>
      @import '../styles/global.css';
    </style>
    <!-- 文字不隐藏等待字体：font-display: swap 让文字立即用回退字体显示，webfont 就绪后自动切换，避免 CDN 慢时页面空白 -->
  </head>
  <body>
    <script is:inline type="application/json" id="term-data" set:html={TERMS_JSON}></script>
    <header class="sticky top-0 z-[100] bg-card border-b border-line">
      <div class="container h-[68px] flex items-center justify-between gap-4">
        <div class="flex items-center gap-2.5 shrink-0">
          <a href="/" class="flex items-center gap-2 group">
            <span class="logo-dot" aria-hidden="true"></span>
            <span class="font-mono font-extrabold tracking-tight text-[15px] group-hover:text-accent2 transition-colors">KRV V5</span>
          </a>
          <span class="badge hidden md:inline-block">{badge ?? '217句读'}</span>
        </div>
        <div class="flex items-center gap-2 min-w-0">
          <div id="searchWrap" class="relative shrink min-w-0">
            <span class="search-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </span>
            <input
              id="globalSearch"
              placeholder={searchPlaceholder}
              class="border border-line rounded-full pl-8 pr-4 py-2 w-[38vw] min-w-[110px] max-w-[150px] sm:w-[200px] sm:max-w-none md:w-[240px] xl:w-[280px] bg-card font-mono text-sm outline-none transition-all focus:border-accent2 focus:ring-2 focus:ring-[color-mix(in_srgb,var(--color-accent2)_25%,transparent)]"
            />
            <div id="searchResults" class="hidden absolute top-[42px] left-0 right-0 bg-card border border-line rounded-xl shadow-[var(--shadow-pop)] max-h-[420px] overflow-auto z-50 text-left"></div>
          </div>
          <nav class="hidden lg:flex items-center gap-1">
            {navMain.map((n) => (
              <a href={n.href} class={`navlink ${current === n.href ? 'text-ink font-bold bg-bg2' : 'hover:text-ink hover:bg-bg2'}`} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a>
            ))}
            <div id="moreMenu" class="relative">
              <button id="moreBtn" class="navlink hover:bg-bg2" aria-haspopup="true" aria-expanded="false">更多 ▾</button>
              <div id="morePanel" class="hidden absolute right-0 top-full pt-2 z-50">
                <div class="w-[220px] bg-card border border-line rounded-xl shadow-[var(--shadow-soft)] overflow-hidden">
                  {navMore.map((m) => (
                    <a href={m.href} class="block px-4 py-2.5 hover:bg-bg2 border-b border-line last:border-0">
                      <div class="font-bold text-[11px]">{m.label}</div>
                      <div class="text-[10px] text-muted">{m.desc}</div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </nav>
          <button id="themeToggle" class="toggle hidden sm:inline-flex" title="切换深色/浅色">🌙</button>
          <button id="navToggle" class="lg:hidden hamburger" aria-label="打开菜单" aria-expanded="false">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <nav id="mobileNav" class="mobile-nav" aria-label="移动端导航">
      {navMain.concat(navMore.map((m) => ({ href: m.href, label: m.label }))).map((n) => (
        <a href={n.href} class={current === n.href ? 'active' : ''}>{n.label}</a>
      ))}
    </nav>

    <slot />

    <footer class="container py-12 flex flex-wrap justify-between gap-3 text-sm text-muted border-t border-line mt-14">
      <div>
        <div class="font-mono font-extrabold tracking-tight text-ink mb-1.5">KRV V5</div>
        <span>康德《纯粹理性批判》导读站 · 仅学习交流</span>
      </div>
      <div class="text-right">
        <div class="font-mono text-xs">commentDB 217条 · 全文 7594段 · 全站检索</div>
      </div>
    </footer>

    <script>
      import '../lib/globalSearch';

      // 移动端导航
      const navToggle = document.getElementById('navToggle') as HTMLButtonElement;
      const mobileNav = document.getElementById('mobileNav') as HTMLElement;
      navToggle?.addEventListener('click', () => {
        const open = mobileNav.classList.toggle('open');
        navToggle.classList.toggle('open', open);
        navToggle.setAttribute('aria-expanded', String(open));
      });
      mobileNav?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'A') {
          mobileNav.classList.remove('open');
          navToggle?.classList.remove('open');
          navToggle?.setAttribute('aria-expanded', 'false');
        }
      });

      // 更多下拉
      const moreBtn = document.getElementById('moreBtn') as HTMLButtonElement;
      const morePanel = document.getElementById('morePanel') as HTMLElement;
      moreBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = morePanel.classList.toggle('hidden');
        moreBtn.setAttribute('aria-expanded', String(!open));
      });
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (morePanel && !morePanel.classList.contains('hidden') && !t.closest('#moreMenu')) {
          morePanel.classList.add('hidden');
          moreBtn?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>

    <script>
      // 深色 / 浅色主题
      const themeToggle = document.getElementById('themeToggle') as HTMLButtonElement | null;
      const applyTheme = (t: string) => {
        document.documentElement.dataset.theme = t;
        if (themeToggle) themeToggle.textContent = t === 'dark' ? '☀️' : '🌙';
      };
      let savedTheme: string | null = null;
      try { const t = localStorage.getItem('krv-theme'); if (t === 'dark' || t === 'light') savedTheme = t; } catch { /* ignore */ }
      const initTheme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      applyTheme(initTheme);
      themeToggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        try { localStorage.setItem('krv-theme', next); } catch { /* ignore */ }
      });

      // 原文术语悬浮释义：全文/句读中的 .term 悬停或点击显示定义
      const termDataEl = document.getElementById('term-data') as HTMLScriptElement | null;
      if (termDataEl) {
        const terms = JSON.parse(termDataEl.textContent || '[]') as { k: string; b: string; d: string; x?: string; g: string }[];
        const byKey = new Map(terms.map((t) => [t.k, t]));
        const tip = document.createElement('div');
        tip.id = 'termTip';
        tip.className = 'term-tip';
        document.body.appendChild(tip);
        const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        let lastX = 0, lastY = 0, lastKey = '';
        const show = (term: { k: string; b: string; d: string; x?: string; g: string }, x: number, y: number) => {
          lastX = x; lastY = y;
          if (term.k !== lastKey) {
            lastKey = term.k;
            const same = terms.filter((t) => t.g === term.g && t.k !== term.k);
            const sameShown = same.slice(0, 12);
            const sameMore = same.length > sameShown.length ? `<span class="term-tip-more">…等 ${same.length} 个</span>` : '';
            tip.innerHTML = `
              <div class="term-tip-head"><b>${esc(term.b)}</b>${term.x ? `<span class="term-tip-x">${esc(term.x)}</span>` : ''}</div>
              <div class="term-tip-g">${esc(term.g)}</div>
              <div class="term-tip-d">${esc(term.d)}</div>
              ${same.length ? `<div class="term-tip-same">同类对照：${sameShown.map((s) => `<button class="term-chip" data-k="${s.k}">${esc(s.b)}</button>`).join('')}${sameMore}</div>` : ''}
              <a class="term-tip-link" href="/glossary/">术语库（${terms.length}词）→</a>`;
            tip.querySelectorAll('.term-chip').forEach((ch) =>
              ch.addEventListener('click', () => {
                const t = byKey.get((ch as HTMLElement).dataset.k ?? '');
                if (t) show(t, lastX, lastY);
              })
            );
          }
          tip.classList.add('show');
          const r = tip.getBoundingClientRect();
          const M = 10;
          let left = x + 14, top = y + 14;
          if (left + r.width > window.innerWidth - M) left = Math.max(M, x - r.width - 14);
          if (top + r.height > window.innerHeight - M) top = Math.max(M, y - r.height - 14);
          // 手机关卡：卡片超高或触点靠边时，强制回夹到视口内，避免整卡落在屏幕外
          left = Math.min(Math.max(M, left), Math.max(M, window.innerWidth - r.width - M));
          top = Math.min(Math.max(M, top), Math.max(M, window.innerHeight - r.height - M));
          tip.style.left = left + 'px';
          tip.style.top = top + 'px';
        };
        const hide = () => tip.classList.remove('show');
        // 宽限期：离开术语后短暂延迟再隐藏，保证光标能从术语移进卡片（点击同类对照等）
        let pinned = false;
        let hideTimer: number | undefined;
        const armHide = () => {
          if (pinned) return;
          window.clearTimeout(hideTimer);
          hideTimer = window.setTimeout(hide, 260);
        };
        const cancelHide = () => window.clearTimeout(hideTimer);
        let current: HTMLElement | null = null;
        document.addEventListener('mouseover', (e) => {
          const t = (e.target as HTMLElement).closest('.term') as HTMLElement | null;
          if (t) {
            cancelHide();
            current = t;
            const term = byKey.get(t.dataset.k ?? '');
            if (term) show(term, e.clientX, e.clientY);
          }
        });
        // 光标进入卡片本身：不隐藏
        tip.addEventListener('mouseover', () => cancelHide());
        document.addEventListener('mouseout', (e) => {
          const t = (e.target as HTMLElement).closest('.term') as HTMLElement | null;
          const rt = e.relatedTarget as HTMLElement | null;
          if (t === current && !(rt && rt.closest && rt.closest('#termTip'))) {
            current = null;
            armHide();
          }
        });
        // 光标离开卡片：延迟隐藏，留出回到术语的路径
        tip.addEventListener('mouseout', (e) => {
          const rt = e.relatedTarget as HTMLElement | null;
          if (!(rt && rt.closest && (rt.closest('#termTip') || rt.closest('.term')))) armHide();
        });
        document.addEventListener('click', (e) => {
          const t = (e.target as HTMLElement).closest('.term') as HTMLElement | null;
          if (t) {
            e.stopPropagation();
            cancelHide();
            pinned = true;
            tip.classList.add('pinned');
            const term = byKey.get(t.dataset.k ?? '');
            if (term) show(term, e.clientX, e.clientY);
          } else if (!(e.target as HTMLElement).closest('#termTip')) {
            pinned = false;
            tip.classList.remove('pinned');
            hide();
          }
        });
        window.addEventListener('scroll', () => { pinned = false; tip.classList.remove('pinned'); hide(); }, { passive: true });
        window.addEventListener('resize', () => { pinned = false; tip.classList.remove('pinned'); hide(); });
      }
    </script>
  </body>
</html>
