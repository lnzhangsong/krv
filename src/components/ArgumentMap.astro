---
import { CHAIN } from '../lib/chapters';
interface Props { current: string }
const { current } = Astro.props;
const idx = CHAIN.findIndex((s) => s.link === `/${current}/`);
---

<div class="argmap">
  <div class="argmap-head">
    <span class="argmap-title">论证地图 · 全书怎么走下来的</span>
    <span class="argmap-hint">总问题 → 四部，环环相扣</span>
  </div>

  <div class="argmap-chain">
    {
      CHAIN.map((s, i) => {
        const isCur = i === idx;
        const isBefore = i < idx;
        return (
          <div class={`argmap-step ${isCur ? 'is-current' : ''} ${isBefore ? 'is-done' : ''}`}>
            <span class="argmap-seq">{i + 1}</span>
            <div class="argmap-label">{s.link ? <a href={s.link}>{s.label}</a> : s.label}</div>
          </div>
        );
      })
    }
  </div>

  <div class="argmap-now">
    <b class="argmap-now-label">当前这一步 · {CHAIN[idx]?.label}</b>
    <span class="argmap-now-answer">{CHAIN[idx]?.answer}</span>
    {CHAIN[idx + 1] && <span class="argmap-now-next">下一步 → {CHAIN[idx + 1].label}：{CHAIN[idx + 1].question}</span>}
  </div>
</div>

<style>
  .argmap {
    margin-top: 16px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    padding: 18px 20px;
    background: var(--color-card);
    box-shadow: var(--shadow-soft);
  }
  .argmap-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .argmap-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 15px;
    color: var(--color-ink);
  }
  .argmap-hint {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
    letter-spacing: 0.06em;
  }
  /* 步骤条：横排，节点圆点 + 标签 */
  .argmap-chain {
    display: flex;
    align-items: flex-start;
    gap: 0;
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .argmap-step {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-card);
    position: relative;
  }
  .argmap-step + .argmap-step {
    margin-left: 18px;
  }
  .argmap-step + .argmap-step::before {
    content: '→';
    position: absolute;
    left: -14px;
    color: color-mix(in srgb, var(--color-accent2) 70%, var(--color-line));
    font-size: 12px;
  }
  .argmap-seq {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--color-bg2);
    border: 1px solid var(--color-line);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
    flex-shrink: 0;
  }
  .argmap-label {
    font-size: 13px;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .argmap-label a {
    color: inherit;
  }
  .argmap-label a:hover {
    color: var(--color-accent2);
  }
  .argmap-step.is-done .argmap-seq {
    background: color-mix(in srgb, var(--color-accent2) 22%, var(--color-card));
    border-color: color-mix(in srgb, var(--color-accent2) 45%, var(--color-line));
    color: var(--color-accent2);
  }
  .argmap-step.is-current {
    background: var(--color-ink);
    border-color: var(--color-ink);
    box-shadow: 0 4px 14px rgba(20, 20, 26, 0.18);
  }
  .argmap-step.is-current .argmap-seq {
    background: var(--color-accent2);
    border-color: var(--color-accent2);
    color: var(--color-bg);
  }
  .argmap-step.is-current .argmap-label {
    color: var(--color-bg);
    font-weight: 600;
  }
  /* 当前步说明 */
  .argmap-now {
    margin-top: 14px;
    padding: 12px 16px;
    background: var(--color-bg2);
    border-left: 3px solid var(--color-accent2);
    border-radius: 0 10px 10px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .argmap-now-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-accent2);
    letter-spacing: 0.05em;
  }
  .argmap-now-answer {
    font-size: 14px;
    line-height: 1.8;
    color: color-mix(in srgb, var(--color-ink) 84%, var(--color-muted));
  }
  .argmap-now-next {
    font-size: 12px;
    color: var(--color-muted);
    border-top: 1px dashed var(--color-line);
    padding-top: 6px;
  }
  @media (max-width: 640px) {
    .argmap-hint {
      display: none;
    }
  }
</style>
