---
import { CHAIN } from '../lib/chapters';
interface Props { current: string }
const { current } = Astro.props;
const idx = CHAIN.findIndex((s) => s.link === `/${current}/`);
---

<div class="argmap card">
  <div class="argmap-head">
    <span class="h3">论证地图 · 这一步在全书论证中的位置</span>
    <span class="font-mono text-[10px] text-muted">总问题 → 四部，环环相扣</span>
  </div>
  <div class="argmap-chain">
    {
      CHAIN.map((s, i) => (
        <div class={`argmap-step ${i === idx ? 'is-current' : ''}`}>
          <div class="argmap-node">
            {s.link ? <a href={s.link}>{s.label}</a> : s.label}
          </div>
          <div class="argmap-q">{s.question}</div>
        </div>
      ))
    }
  </div>
  <div class="argmap-answer">
    <b class="argmap-here">当前步 · {CHAIN[idx]?.label}</b>
    <p>{CHAIN[idx]?.answer}</p>
  </div>
</div>

<style>
  .argmap {
    margin-top: 14px;
  }
  .argmap-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .argmap-chain {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 8px;
    align-items: stretch;
  }
  .argmap-step {
    position: relative;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: 12px 14px;
    background: var(--color-card);
    transition: border-color 0.18s, background 0.18s;
  }
  .argmap-step + .argmap-step::before {
    content: '→';
    position: absolute;
    left: -9px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-accent2);
    font-size: 13px;
    z-index: 1;
  }
  .argmap-step.is-current {
    border-color: var(--color-accent2);
    background: color-mix(in srgb, var(--color-accent2) 10%, var(--color-card));
    box-shadow: 0 4px 14px rgba(26, 58, 95, 0.08);
  }
  .argmap-node {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 15px;
    color: var(--color-accent);
  }
  .argmap-node a:hover {
    color: var(--color-accent2);
  }
  .argmap-q {
    font-size: 11.5px;
    color: var(--color-muted);
    margin-top: 4px;
    line-height: 1.6;
  }
  .argmap-answer {
    margin-top: 14px;
    padding: 12px 16px;
    background: var(--color-bg2);
    border-radius: 10px;
    border-left: 3px solid var(--color-accent2);
    font-size: 14px;
    line-height: 1.8;
  }
  .argmap-here {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-accent2);
    display: block;
    margin-bottom: 4px;
    letter-spacing: 0.05em;
  }
  @media (max-width: 700px) {
    .argmap-chain {
      grid-auto-flow: row;
      grid-template-columns: 1fr;
    }
    .argmap-step + .argmap-step::before {
      content: '↓';
      left: 50%;
      top: -14px;
      transform: translateX(-50%);
    }
  }
</style>
