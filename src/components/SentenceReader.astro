---
interface Sentence { start: number; orig: string; exp: string; chunkId: string; role?: string; section?: string }
interface Props { sentences: Sentence[]; pageSize?: number; jumpHref?: string; floating?: boolean }
const { sentences, pageSize = 30, jumpHref = '/quanwen/', floating = true } = Astro.props;
const ROLE_ORDER = ['定义', '论证', '反驳', '结论', '过渡', '例子', '引用'];
const roleCount = (r: string) => sentences.filter((s) => s.role === r).length;
const sections: (string | undefined)[] = sentences.reduce<(string | undefined)[]>((acc, s) => {
  if (!acc.includes(s.section)) acc.push(s.section);
  return acc;
}, []);
const groups = sections.map((name) => ({
  name,
  items: sentences.map((s, i) => ({ s, i })).filter(({ s }) => s.section === name),
}));
const pages = Math.ceil(sentences.length / pageSize);

// 原文成段视图：按 chunk 分组为段落，段落内句子可点击展开讲解
const paraPageSize = 15;
const paragraphs = (() => {
  const map = new Map<string, Sentence[]>();
  for (const s of sentences) {
    const arr = map.get(s.chunkId);
    if (arr) arr.push(s);
    else map.set(s.chunkId, [s]);
  }
  return [...map.entries()].map(([chunkId, sents]) => ({ chunkId, sents }));
})();
const paraGroups = (() => {
  const out: { heading?: string; paras: { chunkId: string; sents: Sentence[] }[] }[] = [];
  let cur: string | undefined;
  for (const p of paragraphs) {
    const sec = p.sents[0]?.section;
    if (sec !== cur) {
      cur = sec;
      out.push({ heading: sec, paras: [] });
    }
    out[out.length - 1].paras.push(p);
  }
  return out;
})();
---

<div class="reader" data-page-size={pageSize} data-para-page-size={paraPageSize}>
  <div class="rd-tools">
    <div class="rd-viewswitch" role="group" aria-label="阅读视图">
      <button class="rd-view-btn" data-view="list" type="button">逐句列表</button>
      <button class="rd-view-btn on" data-view="para" type="button">原文成段</button>
    </div>
    <div class="rd-filters" role="group" aria-label="按句子功能筛选">
      <button class="rd-chip on" data-role="" type="button">全部 <span class="rd-chip-n">{sentences.length}</span></button>
      {
        ROLE_ORDER.filter((r) => roleCount(r) > 0).map((r) => (
          <button class="rd-chip" data-role={r} type="button">{r} <span class="rd-chip-n">{roleCount(r)}</span></button>
        ))
      }
      <span class="flex-1"></span>
      <button class="rd-chip rd-expand-all" type="button">全部展开</button>
    </div>
    {
      sections.length > 1 && (
        <div class="rd-jump" role="group" aria-label="小节快速跳转">
          {
            groups.map((g) => (
              <button class="rd-jump-btn" data-section={g.name ?? ''} type="button">
                {g.name ?? '其余'} <span class="rd-chip-n">{g.items.length}</span>
              </button>
            ))
          }
        </div>
      )
    }
  </div>

  <div class="rd-body">
    <div class="rd-list" style="display:none">
      <div class="flex items-center gap-2 mb-2 flex-wrap">
        <span class="font-mono text-[11px] text-muted">共 {sentences.length} 句 · 每页 {pageSize} 句 · 点击句子展开讲解</span>
      </div>
      {
        groups.map((g) => (
          <div class="rd-sec">
            <div class="rd-section" data-section={g.name ?? ''}>
              <span class="rd-section-title">{g.name ?? '其余'}</span>
              <span class="rd-section-count">{g.items.length}句</span>
            </div>
            {
              g.items.map(({ s, i }) => (
                <div class="rd-item" data-i={i} data-role={s.role ?? '论证'} data-section={g.name ?? ''}>
                  <button class="rd-row" type="button" aria-expanded="false">
                    <span class="rd-ref">段 {s.start + 1}</span>
                    {s.role && <span class={`rd-role rd-role-${s.role}`}>{s.role}</span>}
                    <span class="rd-orig-line">「{s.orig}」</span>
                    <span class="rd-caret" aria-hidden="true">▸</span>
                  </button>
                  <div class="rd-detail" hidden>
                    <div class="rd-orig serif">「{s.orig}」</div>
                    <div class="rd-exp">
                      <span class="rd-label rd-label-exp">邓晓芒讲</span>
                      {s.exp}
                    </div>
                    <div class="rd-detail-foot">
                      <a href={`${jumpHref}#c${s.start}`} class="rd-goto">定位全文 →</a>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        ))
      }
    </div>

    <div class="rd-para-view">
      <div class="flex items-center gap-2 mb-2 flex-wrap">
        <span class="font-mono text-[11px] text-muted">原著 {paragraphs.length} 段 · 每页 {paraPageSize} 段 · 点击句中原文展示解析</span>
      </div>
      {
        paraGroups.map((g) => (
          <div class="rd-sec">
            <div class="rd-section" data-section={g.heading ?? ''}>
              <span class="rd-section-title">{g.heading ?? '其余'}</span>
              <span class="rd-section-count">{g.paras.reduce((n, p) => n + p.sents.length, 0)}句</span>
            </div>
            {
              g.paras.map((p) => (
                <div class="rd-para" data-section={g.heading ?? ''}>
                  <div class="rd-para-head">
                    <span class="rd-ref">段 {p.sents[0].start + 1}</span>
                    <span class="rd-para-count">{p.sents.length}句</span>
                  </div>
                  <p class="rd-para-text">
                    {
                      p.sents.map((s, si) => (
                        <button class="rd-sent" data-si={si} data-role={s.role ?? '论证'} type="button">「{s.orig}」</button>
                      ))
                    }
                  </p>
                  <div class="rd-para-exps">
                    {
                      p.sents.map((s, si) => (
                        <div class="rd-para-exp" data-si={si} hidden>
                          <div class="rd-para-exp-head">
                            <span class="rd-ref">段 {s.start + 1} 的讲解</span>
                            <button class="rd-para-close toggle" type="button">收起 ✕</button>
                          </div>
                          <div class="rd-para-exp-orig serif">「{s.orig}」</div>
                          <div class="rd-exp">
                            <span class="rd-label rd-label-exp">邓晓芒讲</span>
                            {s.exp}
                          </div>
                          <div class="rd-detail-foot">
                            <a href={`${jumpHref}#c${s.start}`} class="rd-goto">定位全文 →</a>
                          </div>
                        </div>
                      ))
                    }
                  </div>
                </div>
              ))
            }
          </div>
        ))
      }
    </div>
  </div>

  <div class="rd-pager" style={`${floating ? '' : 'position:static;transform:none;margin:10px auto 4px;box-shadow:var(--shadow-soft);'}`}>
    <button class="rd-prev toggle" disabled>← 上一页</button>
    <span class="font-mono text-xs text-muted">第 <input class="rd-page-input" type="number" min="1" max={pages} value="1" aria-label="跳到第几页" /> / <span class="rd-total">{pages}</span> 页</span>
    <button class="rd-next toggle">下一页 →</button>
    <span class="w-px self-stretch bg-line"></span>
    <a href={jumpHref} class="toggle">全文直读 →</a>
  </div>
</div>

<script>
  document.querySelectorAll('.reader').forEach((root) => {
    const pageSize = parseInt((root as HTMLElement).dataset.pageSize || '30', 10) || 30;
    const paraPageSize = parseInt((root as HTMLElement).dataset.paraPageSize || '15', 10) || 15;
    const listView = root.querySelector('.rd-list') as HTMLElement | null;
    const paraView = root.querySelector('.rd-para-view') as HTMLElement | null;
    const items = listView ? Array.from(listView.querySelectorAll('.rd-item')) as HTMLElement[] : [];
    const listHeadings = listView ? Array.from(listView.querySelectorAll('.rd-section')) as HTMLElement[] : [];
    const paraItems = paraView ? Array.from(paraView.querySelectorAll('.rd-para')) as HTMLElement[] : [];
    const paraHeadings = paraView ? Array.from(paraView.querySelectorAll('.rd-section')) as HTMLElement[] : [];
    const pageEl = root.querySelector('.rd-page') as HTMLElement | null;
    const totalEl = root.querySelector('.rd-total') as HTMLElement | null;
    const pageInput = root.querySelector('.rd-page-input') as HTMLInputElement | null;
    const prevBtn = root.querySelector('.rd-prev') as HTMLButtonElement | null;
    const nextBtn = root.querySelector('.rd-next') as HTMLButtonElement | null;
    const chips = Array.from(root.querySelectorAll('.rd-chip[data-role]')) as HTMLButtonElement[];
    const viewBtns = Array.from(root.querySelectorAll('.rd-view-btn')) as HTMLButtonElement[];
    const jumpBtns = Array.from(root.querySelectorAll('.rd-jump-btn')) as HTMLButtonElement[];
    const expandAllBtn = root.querySelector('.rd-expand-all') as HTMLButtonElement | null;
    let view: 'list' | 'para' = 'para';
    let listPage = 1;
    let paraPage = 1;
    let role: string | null = null;
    let allOpen = false;

    const pass = (it: HTMLElement) => !role || it.dataset.role === role;
    const paraPass = (p: HTMLElement) => {
      if (!role) return true;
      return Array.from(p.querySelectorAll('.rd-sent')).some((s) => (s as HTMLElement).dataset.role === role);
    };
    const visible = () => (view === 'para' ? paraItems.filter(paraPass) : items.filter(pass));
    const size = () => (view === 'para' ? paraPageSize : pageSize);
    const curPage = () => (view === 'para' ? paraPage : listPage);
    const setPage = (p: number) => {
      if (view === 'para') paraPage = p;
      else listPage = p;
    };
    const totalPages = () => Math.max(1, Math.ceil(visible().length / size()));

    const sync = () => {
      const tp = totalPages();
      const p = curPage();
      if (pageEl) pageEl.textContent = String(p);
      if (totalEl) totalEl.textContent = String(tp);
      if (pageInput) {
        pageInput.max = String(tp);
        pageInput.value = String(p);
      }
      if (prevBtn) prevBtn.disabled = p <= 1;
      if (nextBtn) nextBtn.disabled = p >= tp;
    };

    const apply = () => {
      const isPara = view === 'para';
      const vis = visible();
      const sz = size();
      const tp = Math.max(1, Math.ceil(vis.length / sz));
      const p = Math.min(Math.max(1, curPage()), tp);
      setPage(p);
      const lo = (p - 1) * sz;
      const onPage = new Set(vis.slice(lo, lo + sz));

      if (isPara) {
        paraItems.forEach((x) => {
          x.style.display = onPage.has(x) ? '' : 'none';
        });
        paraItems.forEach((x) => {
          x.querySelectorAll('.rd-sent').forEach((s) => {
            (s as HTMLElement).classList.toggle('off', !!role && (s as HTMLElement).dataset.role !== role);
          });
        });
      } else {
        items.forEach((it) => {
          it.style.display = onPage.has(it) ? '' : 'none';
        });
      }

      const heads = isPara ? paraHeadings : listHeadings;
      heads.forEach((h) => {
        const sec = h.dataset.section;
        h.style.display = vis.some((v) => v.dataset.section === sec && onPage.has(v)) ? '' : 'none';
      });

      if (listView) listView.style.display = isPara ? 'none' : '';
      if (paraView) paraView.style.display = isPara ? '' : 'none';
      if (expandAllBtn) expandAllBtn.style.display = isPara ? 'none' : '';
      sync();
    };

    const go = (p: number) => {
      setPage(p);
      apply();
      const top = root.getBoundingClientRect().top + window.scrollY - 84;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    };

    prevBtn?.addEventListener('click', () => go(curPage() - 1));
    nextBtn?.addEventListener('click', () => go(curPage() + 1));
    pageInput?.addEventListener('change', () => {
      const p = parseInt(pageInput.value, 10);
      if (!Number.isNaN(p)) go(p);
    });

    viewBtns.forEach((b) =>
      b.addEventListener('click', () => {
        view = (b.dataset.view as 'list' | 'para') || 'para';
        viewBtns.forEach((x) => x.classList.toggle('on', x === b));
        apply();
      })
    );

    chips.forEach((c) =>
      c.addEventListener('click', () => {
        role = c.dataset.role || null;
        chips.forEach((x) => x.classList.toggle('on', x === c));
        listPage = 1;
        paraPage = 1;
        apply();
      })
    );

    jumpBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const sec = b.dataset.section ?? '';
        const isPara = view === 'para';
        const vis = isPara ? paraItems.filter(paraPass) : items.filter(pass);
        const idx = vis.findIndex((v) => v.dataset.section === sec);
        if (idx === -1) return;
        setPage(Math.floor(idx / size()) + 1);
        apply();
        const heading = (isPara ? paraHeadings : listHeadings).find((h) => h.dataset.section === sec);
        heading?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
    );

    const setDetail = (it: HTMLElement, open: boolean) => {
      const detail = it.querySelector('.rd-detail') as HTMLElement | null;
      if (!detail) return;
      detail.hidden = !open;
      it.classList.toggle('open', open);
      const row = it.querySelector('.rd-row');
      row?.setAttribute('aria-expanded', String(open));
    };
    const applyExpand = () => {
      items.forEach((it) => setDetail(it, allOpen));
      if (expandAllBtn) expandAllBtn.textContent = allOpen ? '全部收起' : '全部展开';
    };
    expandAllBtn?.addEventListener('click', () => {
      allOpen = !allOpen;
      applyExpand();
    });

    items.forEach((it) => {
      const row = it.querySelector('.rd-row');
      row?.addEventListener('click', () => {
        const detail = it.querySelector('.rd-detail') as HTMLElement | null;
        if (!detail) return;
        setDetail(it, detail.hidden);
      });
    });

    paraItems.forEach((p) => {
      const sents = Array.from(p.querySelectorAll('.rd-sent')) as HTMLElement[];
      const exps = Array.from(p.querySelectorAll('.rd-para-exp')) as HTMLElement[];
      sents.forEach((s) =>
        s.addEventListener('click', () => {
          const exp = exps.find((e) => e.dataset.si === s.dataset.si);
          if (!exp) return;
          exp.hidden = !exp.hidden;
          s.classList.toggle('on', !exp.hidden);
        })
      );
      p.querySelectorAll('.rd-para-close').forEach((b) =>
        b.addEventListener('click', () => {
          const exp = b.closest('.rd-para-exp') as HTMLElement | null;
          if (!exp) return;
          exp.hidden = true;
          const sent = p.querySelector(`.rd-sent[data-si="${exp.dataset.si}"]`);
          sent?.classList.remove('on');
        })
      );
    });

    apply();
  });
</script>

<style>
  .reader {
    position: relative;
  }
  .rd-tools {
    position: sticky;
    top: 76px;
    z-index: 40;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-line);
    border-radius: 16px;
    padding: 10px 12px;
    margin-bottom: 12px;
  }
