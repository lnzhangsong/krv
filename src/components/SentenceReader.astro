    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    border-radius: 999px;
    padding: 1px 8px;
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    background: var(--color-bg2);
    white-space: nowrap;
